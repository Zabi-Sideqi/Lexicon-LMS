@page "/"
@page "/Account/Login"
@layout LMS.Blazor.Client.Layout.LoginLayout

@using System.ComponentModel.DataAnnotations
@using LMS.Shared.DTOs.AuthDtos
@using LMS.Blazor.Services.Authentication

@inject ILogger<Login> Logger
@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager
@inject AccountRedirectManager RedirectManager
@inject RemoteAuthenticationService AuthenticationService

<PageTitle>Lexicon LMS</PageTitle>

<div class="login-screen">
    <div class="login-box">

        <div class="login-brand">
            <div class="brand-icon">📖</div>
            <h1>Lexicon LMS</h1>
        </div>

        <StatusMessage Message="@errorMessage" />

        <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="Input.Email">E-postadress</label>
                <InputText @bind-Value="Input.Email"
                           id="Input.Email"
                           type="email"
                           autocomplete="username"
                           placeholder="teacher@lms.test" />
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>

            <div class="field">
                <label for="Input.Password">Lösenord</label>
                <InputText @bind-Value="Input.Password"
                           id="Input.Password"
                           type="password"
                           autocomplete="current-password"
                           placeholder="••••••••" />
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>

            <button type="submit" class="login-button">LOGGA IN</button>

            @if (Env.IsDevelopment())
            {
                <div class="role-title">Snabbinloggning (demo)</div>
                <div class="role-demo">
                    <button type="submit" name="Demo" value="Student" class="demo-button">Elev</button>
                    <button type="submit" name="Demo" value="Teacher" class="demo-button">Lärare</button>
                </div>
            }
        </EditForm>

        <div class="login-demo">
            Glömt lösenord?
        </div>

    </div>
</div>

@code {
    // Demo-konton (skapas av DataSeedService i Development)
    private const string TeacherEmail = "teacher@lms.test";
    private const string StudentEmail = "student@lms.test";
    private const string DemoPassword = "Password123!";

    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? Demo { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        // Sätt alltid upp formuläret först, annars kraschar renderingen
        Input ??= new();
        editContext = new EditContext(Input);

        // Redan inloggad? Skicka direkt till rätt dashboard.
        var user = HttpContext.User;
        if (HttpMethods.IsGet(HttpContext.Request.Method) && user.Identity?.IsAuthenticated == true)
        {
            if (user.IsInRole("Teacher"))
                NavigationManager.NavigateTo("teacher-dashboard");
            else if (user.IsInRole("Student"))
                NavigationManager.NavigateTo("student-dashboard");
            else
                NavigationManager.NavigateTo("Account/AccessDenied");
        }
    }

    private async Task LoginUser()
    {
        UserAuthDto credentials;

        if (Env.IsDevelopment() && (Demo is "Teacher" or "Student"))
        {
            credentials = new UserAuthDto
            {
                Email = Demo == "Teacher" ? TeacherEmail : StudentEmail,
                Password = DemoPassword
            };
        }
        else
        {
            if (!editContext.Validate())
            {
                return;
            }

            credentials = new UserAuthDto
            {
                Email = Input.Email,
                Password = Input.Password
            };
        }

        var result = await AuthenticationService.LoginAsync(
            credentials,
            HttpContext,
            false,
            HttpContext.RequestAborted);

        switch (result.Status)
        {
            case RemoteLoginStatus.Succeeded:
                Logger.LogInformation("User logged in through the remote API.");
                RedirectManager.RedirectTo(ReturnUrl);
                break;

            case RemoteLoginStatus.InvalidCredentials:
                errorMessage = "Error: Fel e-post eller lösenord.";
                break;

            default:
                errorMessage = "Error: Inloggningstjänsten är inte tillgänglig. Försök igen.";
                break;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "E-post krävs")]
        [EmailAddress(ErrorMessage = "Ogiltig e-postadress")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Lösenord krävs")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}