@inject NavigationManager NavigationManager

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        var isLoggedIn = user?.Identity?.IsAuthenticated == true;

        var target = isLoggedIn
            ? "Account/AccessDenied"
            : $"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}";

        NavigationManager.NavigateTo(target, forceLoad: true);
    }
}
