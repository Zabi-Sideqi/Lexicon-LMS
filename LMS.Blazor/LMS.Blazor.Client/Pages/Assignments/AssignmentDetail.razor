
@page "/assignments/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.DTOs.FeedbackDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Student")]
@inject IApiProxyClient Proxy

<PageTitle>Uppgift</PageTitle>

<p>
    <a href="/assignments" class="btn btn-sm btn-outline-secondary">
        Tillbaka till uppgifter
    </a>
</p>

@if (loading)
{
    <p><em>Laddar...</em></p>
}
else if (assignment is null)
{
    <div class="alert alert-warning">
        Uppgiften hittades inte.
    </div>
}
else
{
    <h1>@assignment.Name</h1>

    <div class="card mb-4">
        <div class="card-body">
            <p class="card-text">@assignment.Description</p>

            <dl class="row mb-0">
                <dt class="col-sm-3">Deadline</dt>
                <dd class="col-sm-9">
                    @assignment.Deadline.ToString("yyyy-MM-dd HH:mm")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <SubmissionStatusBadge Status="assignment.Status" />
                </dd>

                <dt class="col-sm-3">Inlämningstid</dt>
                <dd class="col-sm-9">
                    @(assignment.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                </dd>

                <dt class="col-sm-3">Feedback</dt>
                <dd class="col-sm-9">
                    @(assignment.HasFeedback ? "Finns" : "Ingen ännu")
                </dd>
            </dl>
        </div>
    </div>

    @if (assignment.SubmissionId is null)
    {
        <div class="alert alert-info">
            Du har inte lämnat in uppgiften ännu. Feedback visas när du har lämnat in uppgiften och läraren har gett feedback.
        </div>
    }
    else if (loadingFeedback)
    {
        <p><em>Hämtar feedback...</em></p>
    }
    else if (feedbackError is not null)
    {
        <div class="alert alert-warning">
            @feedbackError
        </div>
    }
    else if (feedback is null || !feedback.Any())
    {
        <div class="alert alert-info">
            Du har inte fått någon feedback på den här inlämningen ännu.
        </div>
    }
    else
    {
        <h2>Feedback från läraren</h2>

        @foreach (var item in feedback.OrderByDescending(f => f.CreatedAt))
        {
            <div class="card mb-3" @key="item.Id">
                <div class="card-body">
                    <p class="card-text" style="white-space: pre-wrap">@item.Text</p>

                    <hr />

                    <small class="text-muted">
                        Lärare: @item.TeacherName
                        <br />
                        Datum: @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </small>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StudentAssignmentDto? assignment;
    private IEnumerable<FeedbackDto>? feedback;
    private bool loading = true;
    private bool loadingFeedback;
    private string? feedbackError;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        assignment = null;
        feedback = null;
        feedbackError = null;

        try
        {
            assignment = await Proxy.SendAsync<StudentAssignmentDto>(
                HttpMethod.Get,
                $"assignments/my/{Id}");

            if (assignment?.SubmissionId is int submissionId)
            {
                await LoadFeedbackAsync(submissionId);
            }
        }
        catch (HttpRequestException)
        {
            assignment = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadFeedbackAsync(int submissionId)
    {
        loadingFeedback = true;
        feedbackError = null;

        try
        {
            feedback = await Proxy.SendAsync<IEnumerable<FeedbackDto>>(
                HttpMethod.Get,
                $"feedback/submission/{submissionId}");
        }
        catch (HttpRequestException)
        {
            feedbackError = "Det gick inte att hämta feedback. Försök igen senare.";
        }
        finally
        {
            loadingFeedback = false;
        }
    }
}
