@page "/assignments/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Student")]
@inject IApiProxyClient Proxy

<PageTitle>Uppgift</PageTitle>

<p>
    <a href="/assignments" class="btn btn-sm btn-outline-secondary">Tillbaka till uppgifter</a>
</p>

@if (loading)
{
    <p><em>Laddar...</em></p>
}
else if (assignment is null)
{
    <div class="alert alert-warning">Uppgiften hittades inte.</div>
}
else
{
    <h1>@assignment.Name</h1>

    <div class="card mb-4">
        <div class="card-body">
            <p class="card-text">@assignment.Description</p>

            <dl class="row mb-0">
                <dt class="col-sm-3">Deadline</dt>
                <dd class="col-sm-9">@assignment.Deadline.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><SubmissionStatusBadge Status="assignment.Status" /></dd>

                <dt class="col-sm-3">Inlämningstid</dt>
                <dd class="col-sm-9">@(assignment.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>

                <dt class="col-sm-3">Inlämnad fil</dt>
                <dd class="col-sm-9">@(assignment.SubmittedFileName ?? "-")</dd>

                <dt class="col-sm-3">Feedback</dt>
                <dd class="col-sm-9">@(assignment.HasFeedback ? "Finns" : "Ingen ännu")</dd>
            </dl>
        </div>
    </div>

    <h2 class="h4">Lämna in</h2>

    <div class="mb-3">
        <label class="form-label">Fil (.pdf eller .docx, max 10 MB)</label>
        <InputFile OnChange="HandleFileSelected" class="form-control" />
        @if (selectedFile is not null)
        {
            <p class="text-muted mt-1">
                Vald: @selectedFile.Name (@(selectedFile.Size / 1024) KB)
            </p>
        }
    </div>

    <button type="button" class="btn btn-primary" @onclick="HandleSubmit"
            disabled="@(selectedFile is null || isUploading)">
        @(isUploading ? "Lämnar in..." : (assignment.SubmittedAt is null ? "Lämna in" : "Lämna in igen"))
    </button>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-success") mt-3">
            @message
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StudentAssignmentDto? assignment;
    private bool loading = true;
    private IBrowserFile? selectedFile;
    private string? message;
    private bool messageIsError;
    private bool isUploading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            assignment = await Proxy.GetAsync<StudentAssignmentDto>($"assignments/my/{Id}");
        }
        catch (HttpRequestException)
        {
            assignment = null;
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        message = null;
    }

    private async Task HandleSubmit()
    {
        if (selectedFile is null)
            return;

        isUploading = true;
        message = null;

        try
        {
            using var content = new MultipartFormDataContent();

            var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "File", selectedFile.Name);

            var updated = await Proxy.SendAsync<StudentAssignmentDto>(
                HttpMethod.Post,
                $"assignments/my/{Id}/submission",
                content);

            if (updated is not null)
                assignment = updated;

            message = "Filen är inlämnad.";
            messageIsError = false;
            selectedFile = null;
        }
        catch (Exception ex)
        {
            message = $"Det gick inte att lämna in filen: {ex.Message}";
            messageIsError = true;
        }
        finally
        {
            isUploading = false;
        }
    }
}
