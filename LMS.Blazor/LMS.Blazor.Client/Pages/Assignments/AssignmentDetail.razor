@page "/assignments/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.DTOs.FeedbackDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Student")]
@inject IApiProxyClient Proxy

<PageTitle>Uppgift</PageTitle>

<div class="assignment-detail-page">
    <a href="/assignments" class="assignment-detail-back">
        <span aria-hidden="true">←</span> Tillbaka till uppgifter
    </a>

    @if (loading)
    {
        <div class="assignment-detail-state" role="status">
            <span class="assignment-detail-spinner" aria-hidden="true"></span>
            <p>Laddar uppgift...</p>
        </div>
    }
    else if (assignment is null)
    {
        <div class="assignment-detail-error" role="alert">
            Uppgiften hittades inte.
        </div>
    }
    else
    {
        <header class="assignment-detail-header">
            <div>
                <span class="assignment-detail-eyebrow">LEXICON LMS</span>
                <h1>@assignment.Name</h1>
                <p>Uppgiftsdetaljer och feedback från din lärare.</p>
            </div>
            <div class="assignment-detail-icon" aria-hidden="true">▤</div>
        </header>

        <section class="assignment-detail-card">
            <div class="assignment-detail-card-heading">
                <h2>Uppgiftsinformation</h2>
                <p>Information om deadline, inlämning och status.</p>
            </div>

            <div class="assignment-detail-description">
                @assignment.Description
            </div>

            <dl class="assignment-detail-meta">
                <div class="assignment-detail-meta-item">
                    <dt>Deadline</dt>
                    <dd>@assignment.Deadline.ToString("yyyy-MM-dd HH:mm")</dd>
                </div>

                <div class="assignment-detail-meta-item">
                    <dt>Status</dt>
                    <dd><SubmissionStatusBadge Status="assignment.Status" /></dd>
                </div>

                <div class="assignment-detail-meta-item">
                    <dt>Inlämningstid</dt>
                    <dd>@(assignment.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                </div>

                <div class="assignment-detail-meta-item">
                    <dt>Feedback</dt>
                    <dd>
                        <span class="assignment-detail-feedback-status @(assignment.HasFeedback ? "available" : "")">
                            @(assignment.HasFeedback ? "Finns" : "Ingen ännu")
                        </span>
                    </dd>
                </div>
            </dl>
        </section>

        @if (assignment.SubmissionId is null)
        {
            <div class="assignment-detail-notice">
                <strong>Ingen inlämning ännu</strong>
                <p>Feedback visas när du har lämnat in uppgiften och läraren har gett feedback.</p>
            </div>
        }
        else
        {
            <section class="assignment-detail-feedback-section">
                <div class="assignment-detail-section-heading">
                    <div>
                        <span class="assignment-detail-eyebrow">ÅTERKOPPLING</span>
                        <h2>Feedback från läraren</h2>
                        <p>Här kan du läsa lärarens kommentarer till din inlämning.</p>
                    </div>
                </div>

                @if (loadingFeedback)
                {
                    <div class="assignment-detail-state" role="status">
                        <span class="assignment-detail-spinner" aria-hidden="true"></span>
                        <p>Hämtar feedback...</p>
                    </div>
                }
                else if (feedbackError is not null)
                {
                    <div class="assignment-detail-error" role="alert">
                        @feedbackError
                    </div>
                }
                else if (feedback is null || !feedback.Any())
                {
                    <div class="assignment-detail-notice">
                        <strong>Ingen feedback ännu</strong>
                        <p>Du har inte fått någon feedback på den här inlämningen ännu.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in feedback.OrderByDescending(f => f.CreatedAt))
                    {
                        <article class="assignment-detail-feedback-card" @key="item.Id">
                            <p class="assignment-detail-feedback-text">@item.Text</p>

                            <div class="assignment-detail-feedback-footer">
                                <span>
                                    <strong>Lärare</strong>
                                    @item.TeacherName
                                </span>
                                <span>
                                    <strong>Datum</strong>
                                    @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                            </div>
                        </article>
                    }
                }
            </section>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private StudentAssignmentDto? assignment;
    private IEnumerable<FeedbackDto>? feedback;
    private bool loading = true;
    private bool loadingFeedback;
    private string? feedbackError;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        assignment = null;
        feedback = null;
        feedbackError = null;

        try
        {
            assignment = await Proxy.SendAsync<StudentAssignmentDto>(
                HttpMethod.Get,
                $"assignments/my/{Id}");

            if (assignment?.SubmissionId is int submissionId)
            {
                await LoadFeedbackAsync(submissionId);
            }
        }
        catch (HttpRequestException)
        {
            assignment = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadFeedbackAsync(int submissionId)
    {
        loadingFeedback = true;
        feedbackError = null;

        try
        {
            feedback = await Proxy.SendAsync<IEnumerable<FeedbackDto>>(
                HttpMethod.Get,
                $"feedback/submission/{submissionId}");
        }
        catch (HttpRequestException)
        {
            feedbackError = "Det gick inte att hämta feedback. Försök igen senare.";
        }
        finally
        {
            loadingFeedback = false;
        }
    }
}
