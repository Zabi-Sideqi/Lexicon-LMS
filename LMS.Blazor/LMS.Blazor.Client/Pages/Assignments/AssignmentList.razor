@page "/assignments"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Student")]
@inject IApiProxyClient Proxy

<PageTitle>Assignments</PageTitle>

<div class="assignment-list-page">
    <header class="assignment-list-header">
        <div>
            <span class="assignment-list-eyebrow">LEXICON LMS</span>
            <h1>My Assignments</h1>
            <p>View your assignments, deadlines, submission status, and teacher feedback.</p>
        </div>

        <div class="assignment-list-icon" aria-hidden="true">▤</div>
    </header>

    @if (errorMessage is not null)
    {
        <div class="assignment-list-error" role="alert">
            <strong>Unable to load assignments</strong>
            <p>@errorMessage</p>
        </div>
    }
    else if (assignments is null)
    {
        <div class="assignment-list-state" role="status">
            <span class="assignment-list-spinner" aria-hidden="true"></span>
            <p>Loading assignments...</p>
        </div>
    }
    else if (!assignments.Any())
    {
        <div class="assignment-list-empty">
            <div class="assignment-list-empty-icon" aria-hidden="true">✓</div>
            <h2>No assignments yet</h2>
            <p>There are no assignments to display right now.</p>
        </div>
    }
    else
    {
        <section class="assignment-list-card">
            <div class="assignment-list-card-heading">
                <div>
                    <h2>Assignment Overview</h2>
                    <p>Here you can find your assignments and their current status.</p>
                </div>
                <span class="assignment-list-count">
                    @assignments.Count() @(assignments.Count() == 1 ? "assignment" : "assignments")
                </span>
            </div>

            <div class="assignment-list-table-wrapper">
                <table class="assignment-list-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Feedback</th>
                            <th><span class="visually-hidden">Åtgärd</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in assignments.OrderBy(a => a.Deadline))
                        {
                            <tr @key="assignment.Id">
                                <td class="assignment-list-name">
                                    @assignment.Name
                                </td>
                                <td class="assignment-list-description">
                                    @assignment.Description
                                </td>
                                <td class="assignment-list-deadline">
                                    @assignment.Deadline.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    <SubmissionStatusBadge Status="assignment.Status" />
                                </td>
                                <td>
                                    @if (assignment.HasFeedback)
                                    {
                                        <span class="assignment-list-feedback available">
                                            Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="assignment-list-feedback">
                                            Not yet
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a href="/assignments/@assignment.Id"
                                       class="assignment-list-view">
                                        View <span aria-hidden="true">→</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private IEnumerable<StudentAssignmentDto>? assignments;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            assignments = await Proxy.GetAsync<IEnumerable<StudentAssignmentDto>>(
                "assignments/my");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not load assignments. Please try again later.";
        }
    }
}
