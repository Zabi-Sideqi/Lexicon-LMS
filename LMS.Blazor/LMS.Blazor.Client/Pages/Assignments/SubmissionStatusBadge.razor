@using LMS.Shared.Enums

<span class="submission-status-badge @CssClass">
    @Text
</span>

@code {
    [Parameter, EditorRequired]
    public SubmissionStatus Status { get; set; }

    private string Text => Status switch
    {
        SubmissionStatus.NotSubmitted => "Ej inlämnad",
        SubmissionStatus.Submitted => "Inlämnad",
        SubmissionStatus.SubmittedLate => "Inlämnad för sent",
        SubmissionStatus.Late => "Försenad",
        _ => Status.ToString()
    };

    private string CssClass => Status switch
    {
        SubmissionStatus.NotSubmitted => "status-not-submitted",
        SubmissionStatus.Submitted => "status-submitted",
        SubmissionStatus.SubmittedLate => "status-submitted-late",
        SubmissionStatus.Late => "status-late",
        _ => "status-unknown"
    };
}
