@page "/users/create"
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Blazor.Client.Services.ApiProxy
@using System.Text.Json
@using LMS.Shared.DTOs.CourseDtos

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Create User</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Create User</h1>
        </div>

        <a class="btn btn-outline-primary" href="/users">
            Back
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <h5 class="card-title mb-4">
                User Details
            </h5>

            <EditForm Model="@userModel" OnValidSubmit="@HandleValidSubmit">

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label">Username *</label>

                        <InputText class="form-control"
                                   @bind-Value="userModel.UserName"
                                   placeholder="Username" />

                        <ValidationMessage For="@(() => userModel.UserName)" />
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">Email *</label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="userModel.Email"
                                   placeholder="anna@example.com" />

                        <ValidationMessage For="@(() => userModel.Email)" />
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label class="form-label">Password *</label>

                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="userModel.Password"
                                   placeholder="Password" />

                        <ValidationMessage For="@(() => userModel.Password)" />
                    </div>

                    <!-- Role -->
                    <div class="mb-3">
                        <label class="form-label">Role *</label>

                        <InputSelect class="form-select"
                                     @bind-Value="userModel.Role"
                                     @bind-Value:after="HandleRoleChanged">

                            <option value="">Select a role</option>
                            <option value="Student">Student</option>
                            <option value="Teacher">Teacher</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => userModel.Role)" />
                    </div>

                    <!-- Course: required for students only -->
                    @if (userModel.Role == "Student")
                    {
                        <div class="mb-4">
                            <label class="form-label">Course *</label>

                            @if (isLoadingCourses)
                            {
                                <p>Loading courses...</p>
                            }
                            else if (courses.Count == 0)
                            {
                                <div class="alert alert-warning">
                                    No courses could be loaded.
                                    The student cannot be created without a course.
                                </div>
                            }
                            else
                            {
                                <InputSelect class="form-select"
                                             @bind-Value="userModel.CourseId"
                                             required>
                                    <option value="">Select a course</option>

                                    @foreach (var course in courses)
                                    {
                                        <option value="@course.Id">
                                            @course.Name
                                        </option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => userModel.CourseId)" />
                            }
                        </div>
                    }

                </div>

                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                <div class="alert alert-info">
                    Only authorized teachers can create and edit users.
                    Studenter måste kopplas till en kurs. Teacher behöver ingen kurs.
                </div>

                <div class="d-flex gap-2">

                    <button class="btn btn-primary"
                            type="submit"
                            disabled="@(isSaving ||
                                       (userModel.Role == "Student" &&
                                       (isLoadingCourses || courses.Count == 0)))">

                        @if (isSaving)
                        {
                            <span>Creating user...</span>
                        }
                        else
                        {
                            <span>Save User</span>
                        }

                    </button>

                    <a class="btn btn-outline-secondary" href="/users">
                        Cancel
                    </a>

                </div>

            </EditForm>

        </div>
    </div>

</div>

@code {
    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    private UserCreateDto userModel = new();
    private List<CourseDto> courses = new();
    private bool isLoadingCourses = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.SendAsync<List<CourseDto>>(
                HttpMethod.Get,
                "courses");

            courses = result ?? new List<CourseDto>();
        }
        catch (Exception)
        {
            errorMessage = "Courseerna kunde inte hämtas. Ladda om sidan eller försök igen senare.";
        }
        finally
        {
            isLoadingCourses = false;
        }
    }

    private void HandleRoleChanged()
    {
        errorMessage = null;
        successMessage = null;

        if (userModel.Role == "Teacher")
        {
            userModel.CourseId = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Validate the course requirement before sending the user to the API.
            if (userModel.Role == "Student" &&
                (!userModel.CourseId.HasValue || userModel.CourseId.Value <= 0))
            {
                errorMessage = "Select a course for the student.";
                return;
            }

            if (userModel.Role == "Teacher")
            {
                userModel.CourseId = null;
            }

            using var content = JsonContent.Create(userModel);

            var createdUser = await ApiProxyClient.SendAsync<UserResponseDto>(
                HttpMethod.Post,
                "users",
                content);

            if (createdUser is null)
            {
                errorMessage = "The user could not be created.";
                return;
            }

            successMessage = "User created successfully.";
            userModel = new UserCreateDto();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Could not create the user.";

            try
            {
                using var document = JsonDocument.Parse(ex.Message);

                if (document.RootElement.TryGetProperty("message", out var message))
                {
                    errorMessage = message.GetString()
                        ?? "Could not create the user.";
                }
            }
            catch (JsonException)
            {
                // Behåll det generella felmeddelandet.
            }
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred while creating the user.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
