@page "/users/create"
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Blazor.Client.Services.ApiProxy
@using System.Text.Json
@using LMS.Shared.DTOs.CourseDtos

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Skapa användare</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Skapa användare</h1>
        </div>

        <a class="btn btn-outline-primary" href="/users">
            Tillbaka
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <h5 class="card-title mb-4">
                Användaruppgifter
            </h5>

            <EditForm Model="@userModel" OnValidSubmit="@HandleValidSubmit">

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <!-- Användarnamn -->
                    <div class="mb-3">
                        <label class="form-label">Användarnamn *</label>

                        <InputText class="form-control"
                                   @bind-Value="userModel.UserName"
                                   placeholder="Användarnamn" />

                        <ValidationMessage For="@(() => userModel.UserName)" />
                    </div>

                    <!-- E-post -->
                    <div class="mb-3">
                        <label class="form-label">E-post *</label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="userModel.Email"
                                   placeholder="anna@example.com" />

                        <ValidationMessage For="@(() => userModel.Email)" />
                    </div>

                    <!-- Lösenord -->
                    <div class="mb-3">
                        <label class="form-label">Lösenord *</label>

                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="userModel.Password"
                                   placeholder="Lösenord" />

                        <ValidationMessage For="@(() => userModel.Password)" />
                    </div>

                    <!-- Roll -->
                    <div class="mb-3">
                        <label class="form-label">Roll *</label>

                        <InputSelect class="form-select"
                                     @bind-Value="userModel.Role"
                                     @bind-Value:after="HandleRoleChanged">

                            <option value="">Välj roll</option>
                            <option value="Student">Student</option>
                            <option value="Teacher">Lärare</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => userModel.Role)" />
                    </div>

                    <!-- Kurs: endast obligatorisk för Student -->
                    @if (userModel.Role == "Student")
                    {
                        <div class="mb-4">
                            <label class="form-label">Kurs *</label>

                            @if (isLoadingCourses)
                            {
                                <p>Hämtar kurser...</p>
                            }
                            else if (courses.Count == 0)
                            {
                                <div class="alert alert-warning">
                                    Inga kurser kunde hämtas.
                                    Studenten kan inte skapas utan en kurs.
                                </div>
                            }
                            else
                            {
                                <InputSelect class="form-select"
                                             @bind-Value="userModel.CourseId"
                                             required>
                                    <option value="">Välj kurs</option>

                                    @foreach (var course in courses)
                                    {
                                        <option value="@course.Id">
                                            @course.Name
                                        </option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => userModel.CourseId)" />
                            }
                        </div>
                    }

                </div>

                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                <div class="alert alert-info">
                    Endast behöriga lärare kan skapa och ändra användare.
                    Studenter måste kopplas till en kurs. Lärare behöver ingen kurs.
                </div>

                <div class="d-flex gap-2">

                    <button class="btn btn-primary"
                            type="submit"
                            disabled="@(isSaving ||
                                       (userModel.Role == "Student" &&
                                       (isLoadingCourses || courses.Count == 0)))">

                        @if (isSaving)
                        {
                            <span>Skapar användare...</span>
                        }
                        else
                        {
                            <span>Spara användare</span>
                        }

                    </button>

                    <a class="btn btn-outline-secondary" href="/users">
                        Avbryt
                    </a>

                </div>

            </EditForm>

        </div>
    </div>

</div>

@code {
    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    private UserCreateDto userModel = new();
    private List<CourseDto> courses = new();
    private bool isLoadingCourses = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.SendAsync<List<CourseDto>>(
                HttpMethod.Get,
                "courses");

            courses = result ?? new List<CourseDto>();
        }
        catch (Exception)
        {
            errorMessage = "Kurserna kunde inte hämtas. Ladda om sidan eller försök igen senare.";
        }
        finally
        {
            isLoadingCourses = false;
        }
    }

    private void HandleRoleChanged()
    {
        errorMessage = null;
        successMessage = null;

        if (userModel.Role == "Teacher")
        {
            userModel.CourseId = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Kontrollera kurskravet innan användaren skickas till API:t.
            if (userModel.Role == "Student" &&
                (!userModel.CourseId.HasValue || userModel.CourseId.Value <= 0))
            {
                errorMessage = "Välj en kurs för studenten.";
                return;
            }

            if (userModel.Role == "Teacher")
            {
                userModel.CourseId = null;
            }

            using var content = JsonContent.Create(userModel);

            var createdUser = await ApiProxyClient.SendAsync<UserResponseDto>(
                HttpMethod.Post,
                "users",
                content);

            if (createdUser is null)
            {
                errorMessage = "Användaren kunde inte skapas.";
                return;
            }

            successMessage = "Användaren skapades.";
            userModel = new UserCreateDto();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session är inte längre giltig. Logga in igen.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Det gick inte att skapa användaren.";

            try
            {
                using var document = JsonDocument.Parse(ex.Message);

                if (document.RootElement.TryGetProperty("message", out var message))
                {
                    errorMessage = message.GetString()
                        ?? "Det gick inte att skapa användaren.";
                }
            }
            catch (JsonException)
            {
                // Behåll det generella felmeddelandet.
            }
        }
        catch (Exception)
        {
            errorMessage = "Ett oväntat fel uppstod när användaren skulle skapas.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
