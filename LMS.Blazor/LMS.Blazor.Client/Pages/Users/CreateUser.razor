@page "/users/create"
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using LMS.Blazor.Client.Services.ApiProxy
@using System.Text.Json

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Skapa användare</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Skapa användare</h1>

            <p class="text-muted mb-0">
                US01 · Validering och kurskoppling
            </p>
        </div>

        <a class="btn btn-outline-primary" href="/users">
            Tillbaka
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <h5 class="card-title mb-4">
                Användaruppgifter
            </h5>

            <EditForm Model="@userModel" OnValidSubmit="@HandleValidSubmit">

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <!-- Användarnamn -->
                    <div class="mb-3">
                        <label class="form-label">
                            Användarnamn *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="userModel.UserName"
                                   placeholder="Användarnamn" />

                        <ValidationMessage For="@(() => userModel.UserName)" />
                    </div>

                    <!-- E-post -->
                    <div class="mb-3">
                        <label class="form-label">
                            E-post *
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="userModel.Email"
                                   placeholder="anna@example.com" />

                        <ValidationMessage For="@(() => userModel.Email)" />
                    </div>

                    <!-- Lösenord -->
                    <div class="mb-3">
                        <label class="form-label">
                            Lösenord *
                        </label>

                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="userModel.Password"
                                   placeholder="Lösenord" />

                        <ValidationMessage For="@(() => userModel.Password)" />
                    </div>

                    <!-- Roll -->
                    <div class="mb-3">
                        <label class="form-label">
                            Roll *
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="userModel.Role">

                            <option value="">Välj roll</option>
                            <option value="Student">Student</option>
                            <option value="Teacher">Teacher</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => userModel.Role)" />
                    </div>

                    <!-- Kurs -->
                    <div class="mb-4">
                        <label class="form-label">
                            Kurs
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="userModel.CourseId"
                                     placeholder="Kurs-ID" />

                        <ValidationMessage For="@(() => userModel.CourseId)" />
                    </div>

                </div>

                <ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                <div class="alert alert-info">
                    Endast behörig Teacher ska kunna skapa och ändra användare.
                    E-post och obligatoriska fält valideras.
                </div>
                <div class="d-flex gap-2">

                    <button class="btn btn-primary"
                            type="submit"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span>Skapar användare...</span>
                        }
                        else
                        {
                            <span>Spara användare</span>
                        }

                    </button>

                    <a class="btn btn-outline-secondary"
                       href="/users">
                        Avbryt
                    </a>

                </div>

            </EditForm>

        </div>
    </div>

</div>

@code {
    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    private UserCreateDto userModel = new();

    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            using var content = JsonContent.Create(userModel);

            var createdUser = await ApiProxyClient.PostAsync<UserResponseDto>(
                "users",
                content);

            if (createdUser is null)
            {
                errorMessage = "Användaren kunde inte skapas.";
                return;
            }

            successMessage = "Användaren skapades.";

            userModel = new UserCreateDto();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session är inte längre giltig. Logga in igen.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Det gick inte att skapa användaren.";

            try
            {
                using var document = JsonDocument.Parse(ex.Message);

                if (document.RootElement.TryGetProperty("message", out var message))
                {
                    errorMessage = message.GetString()
                        ?? "Det gick inte att skapa användaren.";
                }
            }
            catch (JsonException)
            {
                // Behåll det generella felmeddelandet.
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett fel uppstod: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}