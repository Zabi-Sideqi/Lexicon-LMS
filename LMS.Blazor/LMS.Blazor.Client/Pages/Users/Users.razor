@page "/users"

@using LMS.Shared.DTOs.CommonDtos
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Användare</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Användare</h1>
        </div>
        <a class="btn btn-primary" href="/users/create">
            + Lägg till användare
        </a>
    </div>

    <div class="card users-card">

        <div class="mb-4">
            <SearchBar OnSearch="HandleSearch"
                       Placeholder="Sök användarnamn eller e-post..." />
        </div>

        @if (pagedUsers is null)
        {
            <div class="p-4 text-center">
                <span>Laddar användare...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger m-4">
                @errorMessage
            </div>
        }
        else if (pagedUsers.TotalCount == 0)
        {
            <div class="p-4 text-center text-muted">
                Inga användare hittades.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table users-table mb-0">
                    <thead>
                        <tr>
                            <th>Användarnamn</th>
                            <th>E-post</th>
                            <th>Roll</th>
                            <th>Kurs</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in pagedUsers.Items)
                        {
                            <tr>
                                <td><strong>@user.UserName</strong></td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Student")
                                    {
                                        <span class="badge role-student">Student</span>
                                    }
                                    else
                                    {
                                        <span class="badge role-teacher">Teacher</span>
                                    }
                                </td>
                                <td>@(user.CourseId?.ToString() ?? "–")</td>
                                <td>
                                    <span class="badge status-active">Aktiv</span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/users/edit/{user.Id}")">
                                        Redigera
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger ms-2"
                                            type="button"
                                            @onclick="() => DeleteUser(user)">
                                        Ta bort
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <small class="text-muted">
                    Sida @pagedUsers.PageNumber av @pagedUsers.TotalPages
                    (@pagedUsers.TotalCount totalt)
                </small>
                <Pager PageNumber="pagedUsers.PageNumber"
                       TotalPages="pagedUsers.TotalPages"
                       OnPageChange="HandlePageChange" />
            </div>
        }

    </div>

</div>

@code {

    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    private PagedList<UserResponseDto>? pagedUsers;
    private PageParameters pageParameters = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;

        try
        {
            var url = $"users/paged?pageNumber={pageParameters.PageNumber}" +
                      $"&pageSize={pageParameters.PageSize}" +
                      $"&searchTerm={Uri.EscapeDataString(pageParameters.SearchTerm ?? "")}" +
                      $"&sortOrder={Uri.EscapeDataString(pageParameters.SortOrder ?? "")}";

            pagedUsers = await ApiProxyClient.GetAsync<PagedList<UserResponseDto>>(url);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session är inte längre giltig. Logga in igen.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Det gick inte att hämta användare: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett fel uppstod: {ex.Message}";
        }
    }

    private async Task HandleSearch(string searchTerm)
    {
        pageParameters.SearchTerm = searchTerm;
        pageParameters.PageNumber = 1;
        await LoadAsync();
    }

    private async Task HandlePageChange(int pageNumber)
    {
        pageParameters.PageNumber = pageNumber;
        await LoadAsync();
    }

    private async Task DeleteUser(UserResponseDto user)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Vill du verkligen ta bort användaren {user.UserName}?");

        if (!confirmed)
            return;

        try
        {
            await ApiProxyClient.SendAsync<object>(
                HttpMethod.Delete,
                $"users/{user.Id}");

            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session har gått ut. Logga in igen.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Det gick inte att ta bort användaren: {ex.Message}";
        }
    }
}