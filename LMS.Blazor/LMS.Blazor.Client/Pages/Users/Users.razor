@page "/users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Användare</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Användare</h1>
            <p class="text-muted mb-0">
                US01 · Administrera elever och lärare
            </p>
        </div>

        <a class="btn btn-primary" href="/users/create">
            + Lägg till användare
        </a>
    </div>

    <div class="card users-card">

        <div class="searchbar">

            <input class="form-control"
                   type="search"
                   placeholder="Sök namn eller e-post..." />

            <select class="form-select">
                <option value="">Alla roller</option>
                <option value="Student">Student</option>
                <option value="Teacher">Teacher</option>
            </select>

            <button class="btn btn-primary" type="button">
                Sök
            </button>

        </div>

        <div class="table-responsive">

            <table class="table users-table mb-0">

                <thead>
                    <tr>
                        <th>Namn</th>
                        <th>E-post</th>
                        <th>Roll</th>
                        <th>Kurs</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <strong>Anna Andersson</strong>
                        </td>

                        <td>
                            anna@example.com
                        </td>

                        <td>
                            <span class="badge role-student">
                                Student
                            </span>
                        </td>

                        <td>
                            FED101
                        </td>

                        <td>
                            <span class="badge status-active">
                                Aktiv
                            </span>
                        </td>

                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="/users/edit/1">
                                Redigera
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <strong>Sara Lindberg</strong>
                        </td>

                        <td>
                            sara@example.com
                        </td>

                        <td>
                            <span class="badge role-student">
                                Student
                            </span>
                        </td>

                        <td>
                            FED101
                        </td>

                        <td>
                            <span class="badge status-active">
                                Aktiv
                            </span>
                        </td>

                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="/users/edit/2">
                                Redigera
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <strong>Maria Lärare</strong>
                        </td>

                        <td>
                            maria@example.com
                        </td>

                        <td>
                            <span class="badge role-teacher">
                                Teacher
                            </span>
                        </td>

                        <td>
                            –
                        </td>

                        <td>
                            <span class="badge status-active">
                                Aktiv
                            </span>
                        </td>

                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="/users/edit/3">
                                Redigera
                            </a>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>