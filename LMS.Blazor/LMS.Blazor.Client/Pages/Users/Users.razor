
@page "/users"

@using LMS.Shared.DTOs.CommonDtos
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Users</PageTitle>

<div class="users-page">

    <div class="page-header">
        <div>
            <h1>Users</h1>
        </div>

        <a class="btn btn-primary" href="/users/create">
            + Add User
        </a>
    </div>

    <div class="card users-card">

        <div class="mb-4">
            <SearchBar OnSearch="HandleSearch"
                       Placeholder="Search username or email..." />
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger m-4">
                @errorMessage
            </div>
        }
        else if (pagedUsers is null)
        {
            <div class="p-4 text-center">
                <span>Loading users...</span>
            </div>
        }
        else if (pagedUsers.TotalCount == 0)
        {
            <div class="p-4 text-center text-muted">
                No users found.
            </div>
        }
        else
        {
            <!-- Desktop table -->
            <div class="table-responsive users-desktop-table">
                <table class="table users-table mb-0">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Course</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in pagedUsers.Items)
                        {
                            <tr>
                                <td><strong>@user.UserName</strong></td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Student")
                                    {
                                        <span class="badge role-student">Student</span>
                                    }
                                    else
                                    {
                                        <span class="badge role-teacher">Teacher</span>
                                    }
                                </td>
                                <td>@(user.CourseId?.ToString() ?? "–")</td>
                                <td>
                                    <span class="badge status-active">Active</span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/users/edit/{user.Id}")">
                                        Edit
                                    </a>

                                    <button class="btn btn-sm btn-outline-danger ms-2"
                                            type="button"
                                            @onclick="() => DeleteUser(user)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile user cards -->
            <div class="users-mobile-cards">
                @foreach (var user in pagedUsers.Items)
                {
                    <div class="user-mobile-card" @key="user.Id">

                        <div class="user-mobile-row">
                            <span>Username</span>
                            <strong>@user.UserName</strong>
                        </div>

                        <div class="user-mobile-row">
                            <span>Email</span>
                            <span>@user.Email</span>
                        </div>

                        <div class="user-mobile-row">
                            <span>Role</span>
                            @if (user.Role == "Student")
                            {
                                <span class="badge role-student">Student</span>
                            }
                            else
                            {
                                <span class="badge role-teacher">Teacher</span>
                            }
                        </div>

                        <div class="user-mobile-row">
                            <span>Course</span>
                            <span>@(user.CourseId?.ToString() ?? "–")</span>
                        </div>

                        <div class="user-mobile-row">
                            <span>Status</span>
                            <span class="badge status-active">Active</span>
                        </div>

                        <div class="user-mobile-actions">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/users/edit/{user.Id}")">
                                Edit
                            </a>

                            <button class="btn btn-sm btn-outline-danger"
                                    type="button"
                                    @onclick="() => DeleteUser(user)">
                                Delete
                            </button>
                        </div>

                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <small class="text-muted">
                    Page @pagedUsers.PageNumber of @pagedUsers.TotalPages
                    (@pagedUsers.TotalCount total)
                </small>

                <Pager PageNumber="pagedUsers.PageNumber"
                       TotalPages="pagedUsers.TotalPages"
                       OnPageChange="HandlePageChange" />
            </div>
        }

    </div>
</div>

@code {

    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    private PagedList<UserResponseDto>? pagedUsers;
    private PageParameters pageParameters = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = null;

        try
        {
            var url = $"users/paged?pageNumber={pageParameters.PageNumber}" +
                      $"&pageSize={pageParameters.PageSize}" +
                      $"&searchTerm={Uri.EscapeDataString(pageParameters.SearchTerm ?? "")}" +
                      $"&sortOrder={Uri.EscapeDataString(pageParameters.SortOrder ?? "")}";

            pagedUsers = await ApiProxyClient.GetAsync<PagedList<UserResponseDto>>(url);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to load users: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private async Task HandleSearch(string searchTerm)
    {
        pageParameters.SearchTerm = searchTerm;
        pageParameters.PageNumber = 1;
        await LoadAsync();
    }

    private async Task HandlePageChange(int pageNumber)
    {
        pageParameters.PageNumber = pageNumber;
        await LoadAsync();
    }

    private async Task DeleteUser(UserResponseDto user)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete the user {user.UserName}?");

        if (!confirmed)
            return;

        try
        {
            await ApiProxyClient.SendAsync<object>(
                HttpMethod.Delete,
                $"users/{user.Id}");

            await LoadAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to delete user: {ex.Message}";
        }
    }
}
