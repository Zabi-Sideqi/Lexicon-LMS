@page "/users/edit/{id}"
@using LMS.Shared.DTOs.UserDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Edit User</PageTitle>

<div class="users-page">
    <div class="page-header">
        <div>
            <h1>Edit User</h1>
        </div>
        <a class="btn btn-outline-primary" href="/users">Back</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (isLoading)
            {
                <div class="alert alert-info">Loading user and courses...</div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage) && userNotLoaded)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }
            else
            {
                <EditForm Model="@userModel" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="mb-3">
                            <label class="form-label">Username *</label>
                            <InputText class="form-control" @bind-Value="userModel.UserName" />
                            <ValidationMessage For="@(() => userModel.UserName)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <InputText class="form-control" type="email" @bind-Value="userModel.Email" />
                            <ValidationMessage For="@(() => userModel.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role *</label>
                            <InputSelect class="form-select" @bind-Value="userModel.Role" @bind-Value:after="HandleRoleChanged">
                                <option value="">Select a role</option>
                                <option value="Student">Student</option>
                                <option value="Teacher">Teacher</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => userModel.Role)" />
                        </div>

                        @if (userModel.Role == "Student")
                        {
                            <div class="mb-4">
                                <label class="form-label">Course *</label>
                                @if (isLoadingCourses)
                                {
                                    <p>Loading courses...</p>
                                }
                                else if (courses.Count == 0)
                                {
                                    <div class="alert alert-warning">No courses could be loaded. The student cannot be saved without a course.</div>
                                }
                                else
                                {
                                    <InputSelect class="form-select" @bind-Value="userModel.CourseId">
                                        <option value="">Select a course</option>
                                        @foreach (var course in courses)
                                        {
                                            <option value="@course.Id">@course.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => userModel.CourseId)" />
                                }
                            </div>
                        }
                    </div>

                    <ValidationSummary />
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success" role="status">@successMessage</div>
                    }

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit"
                                disabled="@(isSaving || isLoadingCourses && userModel.Role == "Student" || userModel.Role == "Student" && courses.Count == 0)">
                            @(isSaving ? "Saving..." : "Save User")
                        </button>
                        <a class="btn btn-outline-secondary" href="/users">Cancel</a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;

    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    private UserUpdateDto userModel = new();
    private List<CourseDto> courses = new();
    private bool isLoading = true;
    private bool isLoadingCourses = true;
    private bool isSaving;
    private bool userNotLoaded;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCourses(), LoadUser());
        isLoading = false;
    }

    private async Task LoadCourses()
    {
        try
        {
            var result = await ApiProxyClient.SendAsync<List<CourseDto>>(HttpMethod.Get, "courses");
            courses = result ?? new List<CourseDto>();
        }
        catch (Exception)
        {
            errorMessage = "Courseerna kunde inte hämtas. Ladda om sidan eller försök senare.";
        }
        finally
        {
            isLoadingCourses = false;
        }
    }

    private void HandleRoleChanged()
    {
        errorMessage = null;
        successMessage = null;
        if (userModel.Role == "Teacher")
            userModel.CourseId = null;
    }

    private async Task LoadUser()
    {
        try
        {
            var user = await ApiProxyClient.SendAsync<UserResponseDto>(HttpMethod.Get, $"users/{id}");
            if (user is null)
            {
                userNotLoaded = true;
                errorMessage = "The user could not be found.";
                return;
            }

            userModel = new UserUpdateDto
            {
                UserName = user.UserName,
                Email = user.Email,
                Role = user.Role,
                CourseId = user.CourseId
            };
        }
        catch (UnauthorizedAccessException)
        {
            userNotLoaded = true;
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException)
        {
            userNotLoaded = true;
            errorMessage = "Could not load the user. Check your connection and try again.";
        }
        catch (Exception)
        {
            userNotLoaded = true;
            errorMessage = "An unexpected error occurred while loading the user.";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (userModel.Role == "Student" &&
                (!userModel.CourseId.HasValue ||
                 userModel.CourseId.Value <= 0 ||
                 !courses.Any(c => c.Id == userModel.CourseId.Value)))
            {
                errorMessage = "Select a valid course for the student.";
                return;
            }

            if (userModel.Role == "Teacher")
                userModel.CourseId = null;

            using var content = JsonContent.Create(userModel);
            var updatedUser = await ApiProxyClient.SendAsync<UserResponseDto>(HttpMethod.Put, $"users/{id}", content);
            if (updatedUser is null)
            {
                errorMessage = "The user could not be updated. Check the details and try again.";
                return;
            }

            successMessage = "User updated successfully.";
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not update the user. Check the email, role, and course, then try again.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred while updating the user.";
        }
        finally
        {
            isSaving = false;
        }
    }
}