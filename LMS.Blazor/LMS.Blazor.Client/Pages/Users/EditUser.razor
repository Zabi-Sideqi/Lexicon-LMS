@page "/users/edit/{id}"
@using LMS.Shared.DTOs.UserDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Redigera användare</PageTitle>

<div class="users-page">
    <div class="page-header">
        <div>
            <h1>Redigera användare</h1>
        </div>
        <a class="btn btn-outline-primary" href="/users">Tillbaka</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (isLoading)
            {
                <div class="alert alert-info">Laddar användare och kurser...</div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage) && userNotLoaded)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }
            else
            {
                <EditForm Model="@userModel" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="mb-3">
                            <label class="form-label">Användarnamn *</label>
                            <InputText class="form-control" @bind-Value="userModel.UserName" />
                            <ValidationMessage For="@(() => userModel.UserName)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-post *</label>
                            <InputText class="form-control" type="email" @bind-Value="userModel.Email" />
                            <ValidationMessage For="@(() => userModel.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Roll *</label>
                            <InputSelect class="form-select" @bind-Value="userModel.Role" @bind-Value:after="HandleRoleChanged">
                                <option value="">Välj roll</option>
                                <option value="Student">Student</option>
                                <option value="Teacher">Lärare</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => userModel.Role)" />
                        </div>

                        @if (userModel.Role == "Student")
                        {
                            <div class="mb-4">
                                <label class="form-label">Kurs *</label>
                                @if (isLoadingCourses)
                                {
                                    <p>Hämtar kurser...</p>
                                }
                                else if (courses.Count == 0)
                                {
                                    <div class="alert alert-warning">Inga kurser kunde hämtas. Studenten kan inte sparas utan en kurs.</div>
                                }
                                else
                                {
                                    <InputSelect class="form-select" @bind-Value="userModel.CourseId">
                                        <option value="">Välj kurs</option>
                                        @foreach (var course in courses)
                                        {
                                            <option value="@course.Id">@course.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => userModel.CourseId)" />
                                }
                            </div>
                        }
                    </div>

                    <ValidationSummary />
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success" role="status">@successMessage</div>
                    }

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit"
                                disabled="@(isSaving || isLoadingCourses && userModel.Role == "Student" || userModel.Role == "Student" && courses.Count == 0)">
                            @(isSaving ? "Sparar..." : "Spara användare")
                        </button>
                        <a class="btn btn-outline-secondary" href="/users">Avbryt</a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;

    [Inject]
    private IApiProxyClient ApiProxyClient { get; set; } = default!;

    private UserUpdateDto userModel = new();
    private List<CourseDto> courses = new();
    private bool isLoading = true;
    private bool isLoadingCourses = true;
    private bool isSaving;
    private bool userNotLoaded;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCourses(), LoadUser());
        isLoading = false;
    }

    private async Task LoadCourses()
    {
        try
        {
            var result = await ApiProxyClient.SendAsync<List<CourseDto>>(HttpMethod.Get, "courses");
            courses = result ?? new List<CourseDto>();
        }
        catch (Exception)
        {
            errorMessage = "Kurserna kunde inte hämtas. Ladda om sidan eller försök senare.";
        }
        finally
        {
            isLoadingCourses = false;
        }
    }

    private void HandleRoleChanged()
    {
        errorMessage = null;
        successMessage = null;
        if (userModel.Role == "Teacher")
            userModel.CourseId = null;
    }

    private async Task LoadUser()
    {
        try
        {
            var user = await ApiProxyClient.SendAsync<UserResponseDto>(HttpMethod.Get, $"users/{id}");
            if (user is null)
            {
                userNotLoaded = true;
                errorMessage = "Användaren kunde inte hittas.";
                return;
            }

            userModel = new UserUpdateDto
            {
                UserName = user.UserName,
                Email = user.Email,
                Role = user.Role,
                CourseId = user.CourseId
            };
        }
        catch (UnauthorizedAccessException)
        {
            userNotLoaded = true;
            errorMessage = "Din session är inte längre giltig. Logga in igen.";
        }
        catch (HttpRequestException)
        {
            userNotLoaded = true;
            errorMessage = "Användaren kunde inte hämtas. Kontrollera anslutningen och försök igen.";
        }
        catch (Exception)
        {
            userNotLoaded = true;
            errorMessage = "Ett oväntat fel uppstod när användaren skulle hämtas.";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (userModel.Role == "Student" &&
                (!userModel.CourseId.HasValue ||
                 userModel.CourseId.Value <= 0 ||
                 !courses.Any(c => c.Id == userModel.CourseId.Value)))
            {
                errorMessage = "Välj en giltig kurs för studenten.";
                return;
            }

            if (userModel.Role == "Teacher")
                userModel.CourseId = null;

            using var content = JsonContent.Create(userModel);
            var updatedUser = await ApiProxyClient.SendAsync<UserResponseDto>(HttpMethod.Put, $"users/{id}", content);
            if (updatedUser is null)
            {
                errorMessage = "Användaren kunde inte uppdateras. Kontrollera uppgifterna och försök igen.";
                return;
            }

            successMessage = "Användaren uppdaterades.";
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session är inte längre giltig. Logga in igen.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "Det gick inte att uppdatera användaren. Kontrollera e-post, roll och kurs och försök igen.";
        }
        catch (Exception)
        {
            errorMessage = "Ett oväntat fel uppstod när användaren skulle uppdateras.";
        }
        finally
        {
            isSaving = false;
        }
    }
}