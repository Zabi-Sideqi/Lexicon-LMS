@page "/modules/{ModuleId:int}/activities/create"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.ModuleDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Create activity</PageTitle>
<div class="activity-form-page">
    <a class="activity-back" href="@BackUrl">← Back to module activities</a>
    <section class="activity-form-card">
        <span class="activity-eyebrow">LEXICON LMS · TEACHING</span><h1>Create activity</h1>
        @if (module is not null) { <p class="activity-intro">Create an activity for <strong>@module.Name</strong>. Choose <strong>Assignment</strong> to publish work for students.</p> }
        @if (loading) { <p>Loading module...</p> }
        else if (module is null) { <div class="activity-error" role="alert">@errorMessage</div> }
        else {
            <EditForm Model="model" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="activity-error" role="alert">@errorMessage</div> }
                <div class="activity-field"><label for="activity-type">Activity type</label>
                    <InputSelect id="activity-type" @bind-Value="model.Type" class="activity-input">
                        <option value="Assignment">Assignment</option><option value="Lecture">Lecture</option><option value="ELearning">E-learning</option><option value="Exercise">Exercise</option><option value="Other">Other</option>
                    </InputSelect><small>Select Assignment to create work that students can submit.</small></div>
                <div class="activity-field"><label for="activity-name">Title</label><InputText id="activity-name" @bind-Value="model.Name" class="activity-input" maxlength="150" /><ValidationMessage For="() => model.Name" /></div>
                <div class="activity-field"><label for="activity-description">Instructions / description</label><InputTextArea id="activity-description" @bind-Value="model.Description" class="activity-input activity-textarea" rows="5" /><ValidationMessage For="() => model.Description" /></div>
                <div class="activity-grid">
                    <div class="activity-field"><label for="activity-start">Available from</label><InputDate id="activity-start" Type="InputDateType.DateTimeLocal" @bind-Value="model.StartTime" class="activity-input" /></div>
                    <div class="activity-field"><label for="activity-end">Deadline / end time</label><InputDate id="activity-end" Type="InputDateType.DateTimeLocal" @bind-Value="model.EndTime" class="activity-input" /></div>
                </div>
                <div class="activity-note">Dates must be inside the module period (@module.StartDate.ToString("yyyy-MM-dd") – @module.EndDate.ToString("yyyy-MM-dd")) and cannot overlap another activity in this module.</div>
                <div class="activity-actions"><a class="activity-cancel" href="@BackUrl">Cancel</a><button class="activity-submit" type="submit" disabled="@saving">@(saving ? "Creating..." : "Create activity")</button></div>
            </EditForm>
        }
    </section>
</div>
<style>
.activity-form-page{max-width:850px;margin:0 auto;padding:clamp(1rem,3vw,2rem)}.activity-back{display:inline-block;margin-bottom:1rem;color:#5146e5;text-decoration:none}.activity-form-card{padding:clamp(1.2rem,3vw,2rem);background:var(--bs-body-bg,#fff);border:1px solid #e1e5ec;border-radius:14px;box-shadow:0 4px 14px #1822300d}.activity-eyebrow{font-size:.75rem;letter-spacing:.12em;color:#5146e5;font-weight:700}.activity-form-card h1{margin:.4rem 0;font-size:clamp(1.6rem,3vw,2.2rem)}.activity-intro{color:#687386;margin-bottom:1.5rem}.activity-field{display:flex;flex-direction:column;gap:.4rem;margin:1rem 0}.activity-field label{font-weight:600}.activity-field small{color:#687386}.activity-input{width:100%;min-height:44px;padding:.65rem .75rem;border:1px solid #cbd2dd;border-radius:8px;background:var(--bs-body-bg,#fff);color:inherit}.activity-textarea{min-height:120px;resize:vertical}.activity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.activity-note{padding:.85rem 1rem;background:#f2f4ff;border-radius:8px;color:#414b70;font-size:.9rem}.activity-error{padding:.85rem 1rem;margin:1rem 0;border-radius:8px;background:#fff0f0;color:#9b1c1c}.activity-actions{display:flex;justify-content:flex-end;align-items:center;gap:.75rem;margin-top:1.5rem}.activity-cancel,.activity-submit{padding:.7rem 1.1rem;border-radius:8px;font-weight:600;text-decoration:none;border:1px solid #b7bfcc}.activity-cancel{color:inherit}.activity-submit{background:#5146e5;color:white;border-color:#5146e5;cursor:pointer}.activity-submit:disabled{opacity:.6;cursor:wait}@media(max-width:600px){.activity-grid{grid-template-columns:1fr}.activity-actions{flex-direction:column-reverse;align-items:stretch}.activity-actions>*{text-align:center;width:100%}}
</style>
@code {
    [Parameter] public int ModuleId { get; set; }
    private ModuleDto? module;
    private ActivityCreateDto model = new();
    private bool loading = true, saving;
    private string? errorMessage;
    private string BackUrl => $"/modules/{ModuleId}/activities";
    protected override async Task OnParametersSetAsync() {
        try {
            module = await Proxy.SendAsync<ModuleDto>(HttpMethod.Get, $"modules/{ModuleId}");
            if (module is null) { errorMessage = "The requested module could not be found."; return; }
            model.ModuleId = module.Id; model.Type = "Assignment"; model.Name = ""; model.Description = "";
            model.StartTime = module.StartDate.Date.AddHours(9);
            model.EndTime = module.EndDate.Date.AddHours(16);
            if (model.EndTime <= model.StartTime) model.EndTime = model.StartTime.AddHours(1);
        } catch (UnauthorizedAccessException) { errorMessage = "Your session has expired. Please sign in again."; }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden) { errorMessage = "You are not allowed to manage activities for this module."; }
        catch (HttpRequestException) { errorMessage = "Could not load the module. Please try again."; }
        finally { loading = false; }
    }
    private async Task CreateAsync() {
        errorMessage = null;
        if (module is null) return;
        if (model.StartTime >= model.EndTime) { errorMessage = "The deadline must be later than the availability start time."; return; }
        if (model.StartTime < module.StartDate.Date || model.EndTime > module.EndDate.Date.AddDays(1)) { errorMessage = "The activity must be scheduled within the module dates."; return; }
        saving = true;
        try {
            await Proxy.SendAsync<ActivityDto>(HttpMethod.Post, "activities", JsonContent.Create(model));
            Navigation.NavigateTo(BackUrl);
        } catch (UnauthorizedAccessException) { errorMessage = "Your session has expired. Please sign in again."; }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden) { errorMessage = "Access denied. Only teachers can create activities."; }
        catch (HttpRequestException ex) { errorMessage = ex.Message; }
        catch (Exception) { errorMessage = "An unexpected error occurred while creating the activity."; }
        finally { saving = false; }
    }
}