
@page "/documents"
@using System.ComponentModel.DataAnnotations
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.DocumentDtos
@using LMS.Shared.DTOs.ModuleDtos
@inject IApiProxyClient Proxy

@attribute [Authorize]

<PageTitle>Documents</PageTitle>

<h1>Documents</h1>

<AuthorizeView>
    <Authorized Context="authContext">
        <EditForm Model="uploadModel" OnValidSubmit="HandleUpload">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />
            <div class="mb-3">
                <label class="form-label">Course</label>
                <InputSelect @bind-Value="uploadModel.CourseId"
                             @bind-Value:after="OnCourseSelected"
                             class="form-select">
                    @if (courses.Count > 1)
                    {
                        <option value="">Select a course</option>
                    }
                    @foreach (var c in courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => uploadModel.CourseId" class="text-danger" />
            </div>

            @if (uploadModel.CourseId is > 0)
            {
                <div class="mb-3">
                    <label>Module (optional)</label>
                    <InputSelect @bind-Value="uploadModel.ModuleId" @bind-Value:after="OnModuleChanged">
                        <option value="">— No module —</option>
                        @foreach (var m in modules.Where(m => m.CourseId == uploadModel.CourseId))
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </InputSelect>
                </div>
            }

            @if (uploadModel.ModuleId is > 0)
            {
                <div class="mb-3">
                    <label>Activity (optional)</label>
                    <InputSelect @bind-Value="uploadModel.ActivityId">
                        <option value="">— No activity —</option>
                        @foreach (var a in activities.Where(a => a.ModuleId == uploadModel.ModuleId))
                        {
                            <option value="@a.Id">@a.Name (@a.Type)</option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">File (.pdf or .docx, max 10 MB)</label>
                <InputFile OnChange="HandleFileSelected" class="form-control" />
                @if (selectedFile is not null)
                {
                    <p class="text-muted mt-1">
                        Selected: @selectedFile.Name (@(selectedFile.Size / 1024) KB)
                    </p>
                }
            </div>

            <button type="submit" class="btn btn-primary"
                    disabled="@(selectedFile is null || isUploading || uploadModel.CourseId is null or 0)">
                @(isUploading ? "Uploading..." : "Upload")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(uploadMessage))
        {
            <div class="alert @(uploadError ? "alert-danger" : "alert-success") mt-3" role="@(uploadError ? "alert" : "status")">
                @uploadMessage
            </div>
        }
    </Authorized>
</AuthorizeView>

<h2 class="mt-4">All Documents</h2>

@if (documentLoadWarnings.Count > 0)
{
    <div class="alert alert-warning mt-3" role="alert">
        <strong>Some course documents could not be loaded.</strong>
        <p class="mb-1">The document list may be incomplete. Try refreshing the page.</p>
        <ul class="mb-0">
            @foreach (var courseName in documentLoadWarnings)
            {
                <li>@courseName</li>
            }
        </ul>
    </div>
}

@if (documents is null)
{
    <p><em>Loading...</em></p>
}
else if (!documents.Any())
{
    <p>No documents found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Attachment</th>
                    <th>Type</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documents)
                {
                    <tr>
                        <td>@doc.FileName</td>
                        <td>@doc.AttachPath</td>
                        <td>@doc.ContentType</td>
                        <td>@(doc.FileSize / 1024) KB</td>
                        <td>@doc.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="/api/proxy/documents/@doc.Id/download"
                               class="btn btn-sm btn-secondary">
                                Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CourseDto> courses = new();
    private List<ModuleDto> modules = new();
    private List<ActivityDto> activities = new();
    private List<DocumentDto>? documents;
    private readonly List<string> documentLoadWarnings = new();
    private DocumentUploadModel uploadModel = new();
    private IBrowserFile? selectedFile;
    private string? uploadMessage;
    private bool uploadError;
    private bool isUploading;

    protected override async Task OnInitializedAsync()
    {
        // Try to retrieve all courses first (Teacher)
        try
        {
            courses = await Proxy.GetAsync<List<CourseDto>>("courses") ?? new();
            modules = await Proxy.GetAsync<List<ModuleDto>>("modules") ?? new();
            activities = await Proxy.GetAsync<List<ActivityDto>>("Activities") ?? new();

            if (courses.Count > 0)
            {
                // Teacher: load documents from all available courses.
                documents = new List<DocumentDto>();

                foreach (var course in courses)
                {
                    try
                    {
                        var courseDocuments =
                            await Proxy.GetAsync<List<DocumentDto>>(
                                $"documents/course/{course.Id}");

                        if (courseDocuments is not null)
                        {
                            documents.AddRange(courseDocuments);
                        }
                    }
                    catch (Exception ex)
                    {
                        documentLoadWarnings.Add(
                            string.IsNullOrWhiteSpace(course.Name)
                                ? $"Course {course.Id}"
                                : course.Name);

                        Console.WriteLine(
                            $"Could not load documents for course {course.Id}: {ex.Message}");
                    }
                }

                return;
            }
        }
        catch
        {
            // Ignore and try "my" instead
        }

        // Fallback: retrieve the user's own course (Student)
        try
        {
            var myCourse = await Proxy.GetAsync<StudentCourseDto>("courses/my");
            if (myCourse is not null)
            {
                courses = new List<CourseDto>
                {
                    new(myCourse.Id, myCourse.Name, myCourse.Description,
                        myCourse.StartDate, myCourse.EndDate)
                };
            }
        }
        catch
        {
            courses = new();
        }

        documents = new();

        // If there is only one course (Student): load documents, modules and activities
        if (courses.Count == 1 && courses[0].Id > 0)
        {
            var courseId = courses[0].Id;
            uploadModel.CourseId = courseId;

            try
            {
                modules = await Proxy.GetAsync<List<ModuleDto>>($"modules/course/{courseId}") ?? new();
            }
            catch { modules = new(); }

            try
            {
                activities = await Proxy.GetAsync<List<ActivityDto>>("Activities") ?? new();
            }
            catch { activities = new(); }

            await LoadDocuments(courseId);
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadMessage = null;

        if (selectedFile is not null)
        {
            var ext = Path.GetExtension(selectedFile.Name).ToLowerInvariant();
            if (ext != ".pdf" && ext != ".docx")
            {
                uploadMessage = $"The file type {ext} is not allowed. Allowed types: .pdf, .docx.";
                uploadError = true;
                selectedFile = null;
                return;
            }

            if (selectedFile.Size > 10 * 1024 * 1024)
            {
                uploadMessage = "The file is too large. Maximum size is 10 MB.";
                uploadError = true;
                selectedFile = null;
                return;
            }
        }
    }

    private async Task HandleUpload()
    {
        if (selectedFile is null)
            return;

        if (uploadModel.CourseId is null or 0)
        {
            uploadMessage = "Please select a course first.";
            uploadError = true;
            return;
        }

        isUploading = true;
        uploadMessage = null;

        var uploadedCourseId = uploadModel.CourseId.Value;

        try
        {
            using var content = new MultipartFormDataContent();

            var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            var contentType = string.IsNullOrWhiteSpace(selectedFile.ContentType)
                ? "application/octet-stream"
                : selectedFile.ContentType;

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);

            content.Add(fileContent, "File", selectedFile.Name);

            if (uploadModel.ActivityId is > 0)
            {
                content.Add(new StringContent(uploadModel.ActivityId.Value.ToString()), "ActivityId");
            }
            else if (uploadModel.ModuleId is > 0)
            {
                content.Add(new StringContent(uploadModel.ModuleId.Value.ToString()), "ModuleId");
            }
            else if (uploadModel.CourseId is > 0)
            {
                content.Add(new StringContent(uploadModel.CourseId.Value.ToString()), "CourseId");
            }
            else
            {
                uploadMessage = "Please select a course, module or activity.";
                uploadError = true;
                return;
            }

            var created = await Proxy.SendAsync<DocumentDto>(
                HttpMethod.Post,
                "documents/upload",
                content);

            uploadMessage = $"Uploaded: {created?.FileName}";
            uploadError = false;
            selectedFile = null;

            await LoadDocuments(uploadedCourseId);
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error: {ExtractError(ex.Message)}";
            uploadError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task OnCourseSelected()
    {
        uploadModel.ModuleId = null;
        uploadModel.ActivityId = null;

        if (uploadModel.CourseId is > 0)
            await LoadDocuments(uploadModel.CourseId.Value);
    }

    private void OnModuleChanged()
    {
        uploadModel.ActivityId = null;
    }

    private async Task LoadDocuments(int courseId)
    {
        try
        {
            documents = await Proxy.GetAsync<List<DocumentDto>>(
                $"documents/course/{courseId}") ?? new();
        }
        catch (Exception ex)
        {
            documents = new();
            Console.WriteLine($"Load error: {ex.Message}");
        }
    }

    private static string ExtractError(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return "An error occurred.";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(message);
            if (doc.RootElement.TryGetProperty("detail", out var detail)
                && detail.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return detail.GetString() ?? message;
            }
        }
        catch (System.Text.Json.JsonException) { }

        return message;
    }

    private class DocumentUploadModel
    {
        [Required(ErrorMessage = "Please select a course.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a valid course.")]
        public int? CourseId { get; set; }
        public int? ModuleId { get; set; }
        public int? ActivityId { get; set; }
    }
}