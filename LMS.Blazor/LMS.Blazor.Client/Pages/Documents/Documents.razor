@page "/documents"
@using System.ComponentModel.DataAnnotations
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.DocumentDtos
@using LMS.Shared.DTOs.ModuleDtos
@inject IApiProxyClient Proxy

@attribute [Authorize]

<PageTitle>Documents</PageTitle>

<div class="documents-page">
<h1>Documents</h1>

<AuthorizeView>
    <Authorized Context="authContext">
        <EditForm Model="uploadModel" OnValidSubmit="HandleUpload" class="documents-upload">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />
            <div class="mb-3">
                <label class="form-label" for="document-course-select">Course</label>
                <div class="documents-select">
                    <button id="document-course-select"
                            type="button"
                            class="documents-select-trigger"
                            aria-haspopup="listbox"
                            aria-expanded="@isCourseDropdownOpen"
                            aria-controls="document-course-options"
                            @onclick="ToggleCourseDropdown">
                        <span>@SelectedCourseName</span>
                        <span class="documents-select-chevron" aria-hidden="true">▾</span>
                    </button>
                    @if (isCourseDropdownOpen)
                    {
                        <div id="document-course-options" class="documents-select-options" role="listbox" aria-label="Course options">
                            <button type="button"
                                    class="documents-select-option @(uploadModel.CourseId is null ? "is-selected" : "")"
                                    role="option"
                                    aria-selected="@(uploadModel.CourseId is null)"
                                    @onclick="() => SelectCourseAsync(null)">
                                Select a course
                            </button>
                            @foreach (var course in courses)
                            {
                                <button type="button"
                                        class="documents-select-option @(uploadModel.CourseId == course.Id ? "is-selected" : "")"
                                        role="option"
                                        aria-selected="@(uploadModel.CourseId == course.Id)"
                                        @onclick="() => SelectCourseAsync(course.Id)">
                                    @(string.IsNullOrWhiteSpace(course.Name) ? $"Course {course.Id}" : course.Name)
                                </button>
                            }
                        </div>
                    }
                </div>
                <ValidationMessage For="() => uploadModel.CourseId" class="text-danger" />
            </div>

            @if (uploadModel.CourseId is > 0 && modules.Any(m => m.CourseId == uploadModel.CourseId))
            {
                <div class="mb-3">
                    <label class="form-label" for="document-module-select">Module (optional)</label>
                    <div class="documents-select">
                        <button id="document-module-select"
                                type="button"
                                class="documents-select-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@isModuleDropdownOpen"
                                aria-controls="document-module-options"
                                @onclick="ToggleModuleDropdown">
                            <span>@SelectedModuleName</span>
                            <span class="documents-select-chevron" aria-hidden="true">▾</span>
                        </button>
                        @if (isModuleDropdownOpen)
                        {
                            <div id="document-module-options" class="documents-select-options" role="listbox" aria-label="Module options">
                                <button type="button"
                                        class="documents-select-option @(uploadModel.ModuleId is null ? "is-selected" : "")"
                                        role="option"
                                        aria-selected="@(uploadModel.ModuleId is null)"
                                        @onclick="() => SelectModule(null)">
                                    — No module —
                                </button>
                                @foreach (var module in modules.Where(m => m.CourseId == uploadModel.CourseId))
                                {
                                    <button type="button"
                                            class="documents-select-option @(uploadModel.ModuleId == module.Id ? "is-selected" : "")"
                                            role="option"
                                            aria-selected="@(uploadModel.ModuleId == module.Id)"
                                            @onclick="() => SelectModule(module.Id)">
                                        @module.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (uploadModel.ModuleId is > 0 && activities.Any(a => a.ModuleId == uploadModel.ModuleId))
            {
                <div class="mb-3">
                    <label class="form-label" for="document-activity-select">Activity (optional)</label>
                    <div class="documents-select">
                        <button id="document-activity-select"
                                type="button"
                                class="documents-select-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="@isActivityDropdownOpen"
                                aria-controls="document-activity-options"
                                @onclick="ToggleActivityDropdown">
                            <span>@SelectedActivityName</span>
                            <span class="documents-select-chevron" aria-hidden="true">▾</span>
                        </button>
                        @if (isActivityDropdownOpen)
                        {
                            <div id="document-activity-options" class="documents-select-options" role="listbox" aria-label="Activity options">
                                <button type="button"
                                        class="documents-select-option @(uploadModel.ActivityId is null ? "is-selected" : "")"
                                        role="option"
                                        aria-selected="@(uploadModel.ActivityId is null)"
                                        @onclick="() => SelectActivity(null)">
                                    — No activity —
                                </button>
                                @foreach (var activity in activities.Where(a => a.ModuleId == uploadModel.ModuleId))
                                {
                                    <button type="button"
                                            class="documents-select-option @(uploadModel.ActivityId == activity.Id ? "is-selected" : "")"
                                            role="option"
                                            aria-selected="@(uploadModel.ActivityId == activity.Id)"
                                            @onclick="() => SelectActivity(activity.Id)">
                                        @activity.Name (@activity.Type)
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">File (.pdf or .docx, max 10 MB)</label>
                <InputFile OnChange="HandleFileSelected" class="form-control" />
                @if (selectedFile is not null)
                {
                    <p class="text-muted mt-1">
                        Selected: @selectedFile.Name (@(selectedFile.Size / 1024) KB)
                    </p>
                }
            </div>

            <button type="submit" class="btn btn-primary"
                    disabled="@(selectedFile is null || isUploading || uploadModel.CourseId is null or 0)">
                @(isUploading ? "Uploading..." : "Upload")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(uploadMessage))
        {
            <div class="alert @(uploadError ? "alert-danger" : "alert-success") mt-3" role="@(uploadError ? "alert" : "status")">
                @uploadMessage
            </div>
        }
    </Authorized>
</AuthorizeView>

<h2 class="mt-4">All Documents</h2>

@if (documentLoadWarnings.Count > 0)
{
    <div class="alert alert-warning mt-3" role="alert">
        <strong>Some course documents could not be loaded.</strong>
        <p class="mb-1">The document list may be incomplete. Try refreshing the page.</p>
        <ul class="mb-0">
            @foreach (var courseName in documentLoadWarnings)
            {
                <li>@courseName</li>
            }
        </ul>
    </div>
}

@if (documents is null)
{
    <p><em>Loading...</em></p>
}
else if (!documents.Any())
{
    <p>No documents found.</p>
}
else
{
    <div class="documents-table-scroll"
         role="region"
         aria-label="Documents table"
         tabindex="0">
        <table class="table table-hover align-middle documents-table">
            <colgroup>
                <col class="documents-col-file" />
                <col class="documents-col-attachment" />
                <col class="documents-col-type" />
                <col class="documents-col-size" />
                <col class="documents-col-uploaded" />
                <col class="documents-col-action" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">File Name</th>
                    <th scope="col">Attachment</th>
                    <th scope="col">Type</th>
                    <th scope="col">Size</th>
                    <th scope="col">Uploaded</th>
                    <th scope="col"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documents)
                {
                    <tr @key="doc.Id">
                        <td class="documents-file-name">@doc.FileName</td>
                        <td class="documents-attachment">@doc.AttachPath</td>
                        <td class="documents-content-type">@doc.ContentType</td>
                        <td class="documents-size">@(doc.FileSize / 1024) KB</td>
                        <td class="documents-uploaded">@DateTime.SpecifyKind(doc.UploadedAt, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="documents-action">
                            <a href="/api/proxy/documents/@doc.Id/download"
                               class="btn btn-sm btn-secondary">
                                Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@code {
    private List<CourseDto> courses = new();
    private List<ModuleDto> modules = new();
    private List<ActivityDto> activities = new();
    private List<DocumentDto>? documents;
    private readonly List<string> documentLoadWarnings = new();
    private DocumentUploadModel uploadModel = new();
    private IBrowserFile? selectedFile;
    private string? uploadMessage;
    private bool uploadError;
    private bool isUploading;
    private bool isCourseDropdownOpen;
    private bool isModuleDropdownOpen;
    private bool isActivityDropdownOpen;

    private string SelectedCourseName =>
        courses.FirstOrDefault(course => course.Id == uploadModel.CourseId)?.Name
        ?? "Select a course";

    private string SelectedModuleName =>
        modules.FirstOrDefault(module => module.Id == uploadModel.ModuleId)?.Name
        ?? "— No module —";

    private string SelectedActivityName
    {
        get
        {
            var activity = activities.FirstOrDefault(item => item.Id == uploadModel.ActivityId);
            return activity is null ? "— No activity —" : $"{activity.Name} ({activity.Type})";
        }
    }

    private void ToggleCourseDropdown()
    {
        isCourseDropdownOpen = !isCourseDropdownOpen;
        isModuleDropdownOpen = false;
        isActivityDropdownOpen = false;
    }

    private void ToggleModuleDropdown()
    {
        isModuleDropdownOpen = !isModuleDropdownOpen;
        isCourseDropdownOpen = false;
        isActivityDropdownOpen = false;
    }

    private void ToggleActivityDropdown()
    {
        isActivityDropdownOpen = !isActivityDropdownOpen;
        isCourseDropdownOpen = false;
        isModuleDropdownOpen = false;
    }

    private async Task SelectCourseAsync(int? courseId)
    {
        uploadModel.CourseId = courseId;
        isCourseDropdownOpen = false;
        isModuleDropdownOpen = false;
        isActivityDropdownOpen = false;
        await OnCourseSelected();
    }

    private void SelectModule(int? moduleId)
    {
        uploadModel.ModuleId = moduleId;
        uploadModel.ActivityId = null;
        isModuleDropdownOpen = false;
        isActivityDropdownOpen = false;
    }

    private void SelectActivity(int? activityId)
    {
        uploadModel.ActivityId = activityId;
        isActivityDropdownOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // Try to retrieve all courses first (Teacher)
        try
        {
            courses = await Proxy.GetAsync<List<CourseDto>>("courses") ?? new();
            modules = await Proxy.GetAsync<List<ModuleDto>>("modules") ?? new();
            activities = await Proxy.GetAsync<List<ActivityDto>>("Activities") ?? new();

            if (courses.Count > 0)
            {
                // Teacher: load documents from all available courses.
                documents = new List<DocumentDto>();

                foreach (var course in courses)
                {
                    try
                    {
                        var courseDocuments =
                            await Proxy.GetAsync<List<DocumentDto>>(
                                $"documents/course/{course.Id}");

                        if (courseDocuments is not null)
                        {
                            documents.AddRange(courseDocuments);
                        }
                    }
                    catch (Exception ex)
                    {
                        documentLoadWarnings.Add(
                            string.IsNullOrWhiteSpace(course.Name)
                                ? $"Course {course.Id}"
                                : course.Name);

                        Console.WriteLine(
                            $"Could not load documents for course {course.Id}: {ex.Message}");
                    }
                }

                return;
            }
        }
        catch
        {
            // Ignore and try "my" instead
        }

        // Fallback: retrieve the user's own course (Student)
        try
        {
            var myCourse = await Proxy.GetAsync<StudentCourseDto>("courses/my");
            if (myCourse is not null)
            {
                courses = new List<CourseDto>
                {
                    new(myCourse.Id, myCourse.Name, myCourse.Description,
                        myCourse.StartDate, myCourse.EndDate)
                };
            }
        }
        catch
        {
            courses = new();
        }

        documents = new();

        // If there is only one course (Student): load documents, modules and activities
        if (courses.Count == 1 && courses[0].Id > 0)
        {
            var courseId = courses[0].Id;
            uploadModel.CourseId = courseId;

            try
            {
                modules = await Proxy.GetAsync<List<ModuleDto>>($"modules/course/{courseId}") ?? new();
            }
            catch { modules = new(); }

            try
            {
                activities = await Proxy.GetAsync<List<ActivityDto>>("Activities") ?? new();
            }
            catch { activities = new(); }

            await LoadDocuments(courseId);
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadMessage = null;

        if (selectedFile is not null)
        {
            var ext = Path.GetExtension(selectedFile.Name).ToLowerInvariant();
            if (ext != ".pdf" && ext != ".docx")
            {
                uploadMessage = $"The file type {ext} is not allowed. Allowed types: .pdf, .docx.";
                uploadError = true;
                selectedFile = null;
                return;
            }

            if (selectedFile.Size > 10 * 1024 * 1024)
            {
                uploadMessage = "The file is too large. Maximum size is 10 MB.";
                uploadError = true;
                selectedFile = null;
                return;
            }
        }
    }

    private async Task HandleUpload()
    {
        if (selectedFile is null)
            return;

        if (uploadModel.CourseId is null or 0)
        {
            uploadMessage = "Please select a course first.";
            uploadError = true;
            return;
        }

        isUploading = true;
        uploadMessage = null;

        var uploadedCourseId = uploadModel.CourseId.Value;

        try
        {
            using var content = new MultipartFormDataContent();

            var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            var contentType = string.IsNullOrWhiteSpace(selectedFile.ContentType)
                ? "application/octet-stream"
                : selectedFile.ContentType;

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);

            content.Add(fileContent, "File", selectedFile.Name);

            if (uploadModel.ActivityId is > 0)
            {
                content.Add(new StringContent(uploadModel.ActivityId.Value.ToString()), "ActivityId");
            }
            else if (uploadModel.ModuleId is > 0)
            {
                content.Add(new StringContent(uploadModel.ModuleId.Value.ToString()), "ModuleId");
            }
            else if (uploadModel.CourseId is > 0)
            {
                content.Add(new StringContent(uploadModel.CourseId.Value.ToString()), "CourseId");
            }
            else
            {
                uploadMessage = "Please select a course, module or activity.";
                uploadError = true;
                return;
            }

            var created = await Proxy.SendAsync<DocumentDto>(
                HttpMethod.Post,
                "documents/upload",
                content);

            uploadMessage = $"Uploaded: {created?.FileName}";
            uploadError = false;
            selectedFile = null;

            await LoadDocuments(uploadedCourseId);
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error: {ExtractError(ex.Message)}";
            uploadError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task OnCourseSelected()
    {
        uploadModel.ModuleId = null;
        uploadModel.ActivityId = null;

        if (uploadModel.CourseId is > 0)
            await LoadDocuments(uploadModel.CourseId.Value);
    }

    private void OnModuleChanged()
    {
        uploadModel.ActivityId = null;
    }

    private async Task LoadDocuments(int courseId)
    {
        try
        {
            documents = await Proxy.GetAsync<List<DocumentDto>>(
                $"documents/course/{courseId}") ?? new();
        }
        catch (Exception ex)
        {
            documents = new();
            Console.WriteLine($"Load error: {ex.Message}");
        }
    }

    private static string ExtractError(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return "An error occurred.";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(message);
            if (doc.RootElement.TryGetProperty("detail", out var detail)
                && detail.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return detail.GetString() ?? message;
            }
        }
        catch (System.Text.Json.JsonException) { }

        return message;
    }

    private class DocumentUploadModel
    {
        [Required(ErrorMessage = "Please select a course.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a valid course.")]
        public int? CourseId { get; set; }
        public int? ModuleId { get; set; }
        public int? ActivityId { get; set; }
    }
}