@page "/courses/{CourseId:int}/modules/create"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.ModuleDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using System.Net.Http
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Skapa modul</PageTitle>

<div class="module-create-page">
    <div class="module-create-header">
        <div>
            <span class="module-create-eyebrow">LEXICON LMS</span>
            <h1>Skapa modul</h1>
            <p>Lägg till en modul i kursen och ange dess datum.</p>
        </div>

        <div class="module-create-icon" aria-hidden="true">＋</div>
    </div>

    <div class="module-create-card">
        <div class="module-create-card-heading">
            <h2>Moduluppgifter</h2>
            <p>Fyll i informationen för den nya modulen.</p>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            @if (errorMessage is not null)
            {
                <div class="module-create-error" role="alert">
                    <span class="module-create-error-icon" aria-hidden="true">!</span>
                    <div>
                        <strong>Modulen kunde inte skapas</strong>
                        <p>@errorMessage</p>
                    </div>
                </div>
            }

            <div class="module-create-field">
                <label for="module-name">Namn</label>
                <InputText id="module-name"
                           @bind-Value="model.Name"
                           class="module-create-input"
                           placeholder="Ange modulens namn" />
                <ValidationMessage For="() => model.Name" />
            </div>

            <div class="module-create-field">
                <label for="module-description">Beskrivning</label>
                <InputTextArea id="module-description"
                               @bind-Value="model.Description"
                               class="module-create-input module-create-textarea"
                               placeholder="Beskriv modulens innehåll" />
                <ValidationMessage For="() => model.Description" />
            </div>

            <div class="module-create-date-grid">
                <div class="module-create-field">
                    <label for="module-start-date">Startdatum</label>
                    <InputDate id="module-start-date"
                               @bind-Value="model.StartDate"
                               class="module-create-input" />
                    <ValidationMessage For="() => model.StartDate" />
                </div>

                <div class="module-create-field">
                    <label for="module-end-date">Slutdatum</label>
                    <InputDate id="module-end-date"
                               @bind-Value="model.EndDate"
                               class="module-create-input" />
                    <ValidationMessage For="() => model.EndDate" />
                </div>
            </div>

            <div class="module-create-actions">
                <a href="/courses/@CourseId/modules"
                   class="module-create-cancel">
                    Avbryt
                </a>

                <button type="submit" class="module-create-submit">
                    <span aria-hidden="true">＋</span>
                    Skapa modul
                </button>
            </div>
        </EditForm>
    </div>

    <p class="module-create-footer">
        Kontrollera att modulens datum ligger inom kursens period.
    </p>
</div>

@code {
    // A module belongs to a course, so the course id comes from the address.
    [Parameter]
    public int CourseId { get; set; }

    private ModuleForCreationDto model = new()
    {
        Name = "",
        Description = "",
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(14)
    };

    private string? errorMessage;

    protected override void OnInitialized()
    {
        model.CourseId = CourseId;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (model.EndDate < model.StartDate)
        {
            errorMessage = "Slutdatumet kan inte vara före startdatumet.";
            return;
        }

        try
        {
            await Proxy.SendAsync<ModuleDto>(
                HttpMethod.Post,
                "modules",
                JsonContent.Create(model));

            Navigation.NavigateTo($"/courses/{CourseId}/modules");
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Din session har gått ut. Logga in igen.";
        }
        catch (HttpRequestException ex)
        {
            var message = ex.Message;
            if (message.Contains("overlap", StringComparison.OrdinalIgnoreCase) ||
                message.Contains("överlap", StringComparison.OrdinalIgnoreCase))
                errorMessage = "Modulens datum överlappar en annan modul. Välj ett annat datumintervall.";
            else if (message.Contains("course", StringComparison.OrdinalIgnoreCase) ||
                     message.Contains("kurs", StringComparison.OrdinalIgnoreCase) ||
                     message.Contains("date", StringComparison.OrdinalIgnoreCase) ||
                     message.Contains("datum", StringComparison.OrdinalIgnoreCase))
                errorMessage = "Modulens datum måste ligga inom kursens start- och slutdatum.";
            else
                errorMessage = "Servern kunde inte skapa modulen. Kontrollera uppgifterna och försök igen.";
        }
        catch (Exception)
        {
            errorMessage = "Ett oväntat fel uppstod när modulen skulle skapas.";
        }
    }
}
