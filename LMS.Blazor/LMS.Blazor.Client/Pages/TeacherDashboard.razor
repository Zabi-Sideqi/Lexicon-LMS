@page "/teacher-dashboard"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.DTOs.FeedbackDtos
@using LMS.Shared.DTOs.DashboardDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy

<PageTitle>Teacher Dashboard</PageTitle>

<div class="dashboard">
    <div class="page-head">
        <div>
            <h1>Teacher Dashboard</h1>
            <p>Overview of courses, activities, submissions, and feedback.</p>
        </div>
        <span class="role-badge">Teacher</span>
    </div>

    @if (loading)
    {
        <div class="activity-card">
            <p>Loading dashboard data...</p>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
            <button class="btn btn-outline-primary btn-sm ms-2"
                    @onclick="LoadSubmissionsAsync">
                Try again
            </button>
        </div>
    }
    else
    {
        <div class="stats">
            <a href="/courses" class="stat-card stat-card-link">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5z" />
                        <path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20" />
                        <path d="M8 7h8M8 10h8" />
                    </svg>
                </span>
                <strong>@(dashboard?.Courses.Count ?? 0)</strong>
                <span>Courses</span>
            </a>

            <a href="/calendar" class="stat-card stat-card-link">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                        <path d="m9 15 2 2 4-4" />
                    </svg>
                </span>
                <strong>@(dashboard?.Courses.Sum(course => course.UpcomingActivityCount) ?? 0)</strong>
                <span>Upcoming activities</span>
            </a>

            <a href="#pending-feedback"
               class="stat-card stat-card-link">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 3.9a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z" />
                        <path d="m8.5 12 2.2 2.2 4.8-4.8" />
                    </svg>
                </span>
                <strong>@(dashboard?.PendingFeedbackCount ?? 0)</strong>
                <span>Awaiting feedback</span>
            </a>

            <a href="#attention-items" class="stat-card stat-card-link">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0z" />
                        <path d="M12 9v4M12 16.5h.01" />
                    </svg>
                </span>
                <strong>
                    @((dashboard?.LateSubmissionCount ?? 0)
                        + (dashboard?.MissingSubmissionCount ?? 0))
                </strong>
                <span>Late or missing submissions</span>
            </a>
        </div>

        <div class="activity-card">
            <div class="section-head">
                <h2>My Courses</h2>
            </div>

            @if (dashboard?.Courses.Count > 0)
            {
                @foreach (var course in dashboard.Courses)
                {
                    <div class="activity" @key="course.Id">
                        <strong>@course.Name</strong>
                        <span>
                            @course.StudentCount students
                            · @course.UpcomingActivityCount upcoming activities
                        </span>
                        <span class="badge @(course.IsActive ? "bg-success" : "bg-secondary")">
                            @(course.IsActive ? "Active course" : "Not currently active")
                        </span>
                    </div>
                }
            }
            else
            {
                <p>No courses to display.</p>
            }
        </div>

        <div class="activity-card">
            <div class="section-head">
                <h2>Upcoming Activities</h2>
            </div>

            @if (dashboard?.UpcomingActivities.Count > 0)
            {
                @foreach (var activity in dashboard.UpcomingActivities)
                {
                    <div class="activity" @key="activity.Id">
                        <strong>@activity.Name</strong>
                        <span>
                            @activity.CourseName
                            · @activity.StartTime.ToString("yyyy-MM-dd HH:mm")
                        </span>
                    </div>
                }
            }
            else
            {
                <p>There are no upcoming activities to display.</p>
            }
        </div>

        <div class="activity-card" id="attention-items">
            <div class="section-head">
                <h2>Needs Attention</h2>
            </div>

            @if (dashboard?.AttentionItems.Count > 0)
            {
                @foreach (var item in dashboard.AttentionItems)
                {
                    <div class="activity"
                         @key="(item.ActivityId, item.StudentId)">
                        <strong>@item.StudentName – @item.ActivityName</strong>
                        <span>
                            @item.CourseName
                            · Due: @item.DueAt.ToString("yyyy-MM-dd HH:mm")
                        </span>

                        @if (item.Status == "Late submission")
                        {
                            <span class="badge bg-danger">Late submission</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Missing submission
                            </span>
                        }

                        <a class="btn btn-outline-primary btn-sm"
                           href="@($"/courses/{item.CourseId}/modules")">
                            Open course modules
                        </a>
                    </div>
                }
            }
            else
            {
                <p>There are no late or missing submissions to display.</p>
            }
        </div>

        <div class="activity-card" id="pending-feedback">
            <div class="section-head">
                <h2>Submissions Awaiting Feedback</h2>
            </div>

            @if (!PendingSubmissions.Any())
            {
                <p>There are no submissions awaiting feedback.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Assignment</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var submission in PendingSubmissions)
                            {
                                <tr @key="submission.SubmissionId">
                                    <td>@submission.StudentName</td>
                                    <td>
                                        <strong>@submission.ActivityName</strong>
                                        <div class="text-muted small">
                                            @submission.FileName
                                        </div>
                                    </td>
                                    <td>
                                        @(submission.SubmittedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            Awaiting feedback
                                        </span>
                                    </td>
                                    <td>
                                        @if (submission.SubmissionId is not null)
                                        {
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="() => SelectSubmission(submission)">
                                            Give feedback
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (selectedSubmission is not null)
        {
            <div class="activity-card">
                <h2>Give Feedback</h2>

                <p>
                    <strong>Student:</strong>
                    @selectedSubmission.StudentName
                </p>

                <p>
                    <strong>Assignment:</strong>
                    @selectedSubmission.ActivityName
                </p>

                <div class="mb-3">
                    <label for="feedbackText" class="form-label">
                        Feedback for the student
                    </label>

                    <textarea id="feedbackText"
                              class="form-control"
                              rows="5"
                              maxlength="2000"
                              @bind="feedbackText"
                              placeholder="Enter your feedback here..."></textarea>

                    <small class="text-muted">
                        @feedbackText.Length / 2000 characters
                    </small>
                </div>

                @if (!string.IsNullOrWhiteSpace(feedbackError))
                {
                    <div class="alert alert-danger" role="alert">
                        @feedbackError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(feedbackSuccess))
                {
                    <div class="alert alert-success" role="status">
                        @feedbackSuccess
                    </div>
                }

                <button class="btn btn-primary"
                        disabled="@sendingFeedback"
                        @onclick="SubmitFeedbackAsync">
                    @(sendingFeedback ? "Sending..." : "Send Feedback")
                </button>

                <button class="btn btn-outline-secondary ms-2"
                        disabled="@sendingFeedback"
                        @onclick="CancelFeedback">
                    Cancel
                </button>
            </div>
        }

        <div class="activity-card">
            <h2>Recent Submissions</h2>

            @if (dashboard?.RecentSubmissions.Count > 0)
            {
                @foreach (var submission in dashboard.RecentSubmissions)
                {
                    var age = DateTime.Now - submission.SubmittedAt;
                    var recentlySubmitted =
                        age >= TimeSpan.Zero &&
                        age <= TimeSpan.FromHours(24);

                    <div class="activity" @key="submission.SubmissionId">
                        <strong>
                            @submission.StudentName – @submission.ActivityName
                        </strong>

                        @if (submission.IsLate)
                        {
                            <span class="badge bg-danger ms-2">Late submission</span>
                        }

                        @if (recentlySubmitted)
                        {
                            <span class="badge bg-primary ms-2">
                                New · last 24 hours
                            </span>
                        }

                        <span>
                            @submission.SubmittedAt.ToString("yyyy-MM-dd HH:mm")
                            · @(submission.HasFeedback
                                ? "Feedback provided"
                                : "Feedback needed")
                        </span>
                    </div>
                }
            }
            else
            {
                <p>There are no recent submissions to display yet.</p>
            }
        </div>
    }
</div>

@code {
    private List<TeacherSubmissionDto> submissions = [];
    private TeacherDashboardDto? dashboard;
    private bool loading = true;
    private string? errorMessage;

    private TeacherSubmissionDto? selectedSubmission;
    private string feedbackText = "";
    private string? feedbackError;
    private string? feedbackSuccess;
    private bool sendingFeedback;

    private IEnumerable<TeacherSubmissionDto> PendingSubmissions =>
        submissions
            .Where(s => s.SubmissionId is not null && !s.HasFeedback)
            .OrderBy(s => s.SubmittedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadSubmissionsAsync();
    }

    private async Task LoadSubmissionsAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            dashboard = await Proxy.SendAsync<TeacherDashboardDto>(
                HttpMethod.Get,
                "dashboard/teacher");

            var result = await Proxy.SendAsync<IEnumerable<TeacherSubmissionDto>>(
                HttpMethod.Get,
                "submissions/teacher");

            submissions = result?.ToList() ?? [];
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please log in again.";
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not load dashboard data. Check that the API is running and try again.";
        }
        catch (Exception)
        {
            errorMessage =
                "An unexpected error occurred while loading the dashboard.";
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectSubmission(TeacherSubmissionDto submission)
    {
        selectedSubmission = submission;
        feedbackText = "";
        feedbackError = null;
        feedbackSuccess = null;
    }

    private void CancelFeedback()
    {
        selectedSubmission = null;
        feedbackText = "";
        feedbackError = null;
        feedbackSuccess = null;
    }

    private async Task SubmitFeedbackAsync()
    {
        if (selectedSubmission is null)
        {
            feedbackError = "Select a submission first.";
            return;
        }

        var text = feedbackText.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            feedbackError = "Enter feedback before sending.";
            return;
        }

        if (text.Length > 2000)
        {
            feedbackError = "Feedback can contain a maximum of 2,000 characters.";
            return;
        }

        sendingFeedback = true;
        feedbackError = null;
        feedbackSuccess = null;

        try
        {
            var dto = new FeedbackForCreationDto
            {
                Text = text
            };

            await Proxy.SendAsync<object>(
                HttpMethod.Post,
                $"feedback/submission/{selectedSubmission.SubmissionId}",
                new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(dto),
                    System.Text.Encoding.UTF8,
                    "application/json"));

            feedbackSuccess = "Feedback has been sent to the student.";
            feedbackText = "";

            var submittedId = selectedSubmission.SubmissionId;

            await LoadSubmissionsAsync();

            selectedSubmission = submissions.FirstOrDefault(
                s => s.SubmissionId == submittedId);
        }
        catch (UnauthorizedAccessException)
        {
            feedbackError =
                "You do not have permission, or your session has expired. Please log in again.";
        }
        catch (HttpRequestException)
        {
            feedbackError =
                "Could not send feedback. Check your connection and try again.";
        }
        catch (Exception)
        {
            feedbackError =
                "An unexpected error occurred while sending feedback.";
        }
        finally
        {
            sendingFeedback = false;
        }
    }
}