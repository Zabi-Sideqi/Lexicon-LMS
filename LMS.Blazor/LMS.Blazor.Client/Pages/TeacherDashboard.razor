
@page "/teacher-dashboard"
@using Microsoft.AspNetCore.Authorization
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.DTOs.FeedbackDtos
@using LMS.Shared.DTOs.DashboardDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.ActivityDtos
@using LMS.Shared.Enums
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy

<PageTitle>Teacher Dashboard</PageTitle>

<div class="dashboard">
    <div class="page-head">
        <div>
            <h1>Teacher Dashboard</h1>
            <p>An overview of student submissions, upcoming activities, and feedback that needs your attention.</p>
        </div>
        <span class="role-badge">Teacher</span>
    </div>


    <div class="activity-card mb-3">
        <div class="d-flex flex-wrap align-items-end gap-3">
            <div>
                <label for="statusFilter" class="form-label">Status</label>
                <select id="statusFilter" class="form-select" @bind="selectedStatus">
                    <option value="">All statuses</option>
                    <option value="@nameof(SubmissionStatus.Submitted)">Submitted</option>
                    <option value="@nameof(SubmissionStatus.SubmittedLate)">Submitted late</option>
                    <option value="@nameof(SubmissionStatus.Late)">Late</option>
                    <option value="@nameof(SubmissionStatus.NotSubmitted)">Not submitted</option>
                </select>
            </div>
            <div>
                <label for="courseFilter" class="form-label">Course</label>
                <InputSelect id="courseFilter" class="form-select" @bind-Value="selectedCourseId">
                    <option value="">All courses</option>
                    @foreach (var course in courses)
                    {
                        <option value="@course.Id">@course.Name</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label for="activityFilter" class="form-label">Assignment</label>
                <InputSelect id="activityFilter" class="form-select" @bind-Value="selectedActivityId">
                    <option value="">All assignments</option>
                    @foreach (var activity in activities)
                    {
                        <option value="@activity.Id">@activity.Name</option>
                    }
                </InputSelect>
            </div>
            <button class="btn btn-primary" type="button" @onclick="ApplyFilterAsync">Filter</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="ResetFilterAsync">Clear</button>
        </div>
    </div>

    @if (dashboard is not null)
    {
        <div class="stats">
            <a class="stat-card h-100 text-decoration-none" href="#pending-submissions">
                <span class="stat-icon">⌛</span>
                <strong>@dashboard.PendingFeedback.Count</strong>
                <span>Pending Feedback</span>
            </a>
            <a class="stat-card h-100 text-decoration-none" href="#active-courses">
                <span class="stat-icon">▣</span>
                <strong>@dashboard.ActiveCourses.Count</strong>
                <span>Active Courses</span>
            </a>
            <a class="stat-card h-100 text-decoration-none" href="#today-schedule">
                <span class="stat-icon">◷</span>
                <strong>@dashboard.TodayActivities.Count</strong>
                <span>Today's Schedule</span>
            </a>
            <a class="stat-card h-100 text-decoration-none" href="#late-submissions">
                <span class="stat-icon">!</span>
                <strong>@dashboard.LateSubmissions.Count</strong>
                <span>Late Submissions</span>
            </a>
            <a class="stat-card h-100 text-decoration-none" href="#missing-submissions">
                <span class="stat-icon">?</span>
                <strong>@dashboard.MissingSubmissions.Count</strong>
                <span>Missing Submissions</span>
            </a>
        </div>

        <div class="activity-card" id="active-courses">
            <h2>Active Courses</h2>

            @if (dashboard.ActiveCourses is null ||
                 !dashboard.ActiveCourses.Any())
            {
                <p>You have no active courses right now.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var course in dashboard.ActiveCourses)
                    {
                        <div class="col-12 col-md-6 col-lg-4"
                             @key="course.CourseId">
                            <div class="stat-card h-100">
                                <h3>@course.CourseName</h3>
                                <p class="text-muted mb-0">
                                    @course.StartDate.ToString("yyyy-MM-dd")
                                    –
                                    @course.EndDate.ToString("yyyy-MM-dd")
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>


            <div class="activity-card" id="today-schedule">
                <h2>Today's Schedule</h2>

                @if (!dashboard.TodayActivities.Any())
                {
                    <p>No activities scheduled for today.</p>
                }
                else
                {
                    @foreach (var activity in dashboard.TodayActivities)
                    {
                        <div class="activity" @key="activity.ActivityId">
                            <strong>@activity.ActivityName</strong>
                            <span>@activity.CourseName</span>
                            <span>@activity.StartTime.ToString("HH:mm") - @activity.EndTime.ToString("HH:mm")</span>
                        </div>
                    }
                }
            </div>

            <div class="activity-card" id="upcoming-activities">
                <h2>Upcoming Activities</h2>

                @if (!dashboard.UpcomingActivities.Any())
                {
                    <p>No upcoming activities in the next week.</p>
                }
                else
                {
                    @foreach (var activity in dashboard.UpcomingActivities)
                    {
                        <div class="activity" @key="activity.ActivityId">
                            <strong>@activity.ActivityName</strong>
                            <span>@activity.CourseName</span>
                            <span>
                                @activity.StartTime.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                    }
                }
            </div>

            <div class="activity-card" id="late-submissions">
                <h2>Late Submissions</h2>

                @if (!dashboard.LateSubmissions.Any())
                {
                    <p>There are no late submissions to show.</p>
                }
                else
                {
                    @foreach (var submission in dashboard.LateSubmissions)
                    {
                        <div class="activity" @key="submission.SubmissionId">
                            <strong>@submission.ActivityName</strong>
                            <span>
                                Student: @submission.StudentName
                            </span>
                            <span>
                                Course: @submission.CourseName
                            </span>
                            <span>
                                Submitted:
                                @submission.SubmittedAt.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                    }
                }
            </div>

            <div class="activity-card" id="missing-submissions">
                <h2>Missing Submissions</h2>

                @if (!dashboard.MissingSubmissions.Any())
                {
                    <p>There are no missing submissions to show.</p>
                }
                else
                {
                    @foreach (var missing in dashboard.MissingSubmissions)
                    {
                        <div class="activity" @key="@( $"{missing.ActivityId}-{missing.StudentId}")">
                            <strong>@missing.ActivityName</strong>
                            <span>Student: @missing.StudentName</span>
                            <span>Course: @missing.CourseName</span>
                            <span>
                                Due date:
                                @missing.DueDate.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                    }
                }
            </div>

    }
    @if (dashboardErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">
            @dashboardErrorMessage
            <button class="btn btn-outline-primary btn-sm ms-2"
                    @onclick="LoadDashboardAsync">
                Try again
            </button>
        </div>
    }

    @if (loading)
    {
        <div class="activity-card">
            <p>Loading submissions...</p>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
            <button class="btn btn-outline-primary btn-sm ms-2"
                    @onclick="LoadSubmissionsAsync">
                Try again
            </button>
        </div>
    }
    else
    {
        <div class="stats">
            <div class="stat-card">
                <span class="stat-icon">▣</span>
                <strong>@submissions.Count(s => s.SubmissionId is not null)</strong>
                <span>Submissions</span>
            </div>

            <div class="stat-card">
                <span class="stat-icon">✓</span>
                <strong>@submissions.Count(s => s.SubmissionId is not null && s.HasFeedback)</strong>
                <span>Feedback provided</span>
            </div>

            <div class="stat-card">
                <span class="stat-icon">⌛</span>
                <strong>@PendingCount</strong>
                <span>Awaiting feedback</span>
            </div>

            <div class="stat-card">
                <span class="stat-icon">♙</span>
                <strong>@submissions.Where(s => s.SubmissionId is not null).Select(s => s.StudentId).Distinct().Count()</strong>
                <span>Students with submissions</span>
            </div>
        </div>

        <div class="activity-card" id="pending-submissions">
            <div class="section-head">
                <h2>Submissions Awaiting Feedback</h2>
            </div>

            @if (!PendingSubmissions.Any())
            {
                <p>There are no submissions awaiting feedback.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Assignment</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var submission in PendingSubmissions)
                            {
                                <tr @key="submission.SubmissionId">
                                    <td>@submission.StudentName</td>
                                    <td>
                                        <strong>@submission.ActivityName</strong>
                                        <div class="text-muted small">
                                            @submission.FileName
                                        </div>
                                    </td>
                                    <td>
                                        @(submission.SubmittedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>
                                    <td>
                                        <span class="@GetStatusCssClass(submission.Status)">
                                            @GetStatusText(submission.Status)
                                        </span>
                                    </td>
                                    <td>
                                        @if (submission.SubmissionId is int submissionId)
                                        {
                                            <a href="/api/proxy/submissions/@submissionId/download"
                                               download="@submission.FileName"
                                               class="btn btn-sm btn-secondary me-1">Download</a>
                                            <button class="btn btn-primary btn-sm"
                                                    @onclick="() => SelectSubmission(submission)">
                                                Provide feedback
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (selectedSubmission is not null)
        {
            <div class="activity-card">
                <h2>Provide Feedback</h2>

                <p>
                    <strong>Student:</strong>
                    @selectedSubmission.StudentName
                </p>

                <p>
                    <strong>Assignment:</strong>
                    @selectedSubmission.ActivityName
                </p>

                <div class="mb-3">
                    <label for="feedbackText" class="form-label">
                        Feedback for the student
                    </label>

                    <textarea id="feedbackText"
                              class="form-control"
                              rows="5"
                              maxlength="2000"
                              @bind="feedbackText"
                              placeholder="Write your feedback here...">
                    </textarea>

                    <small class="text-muted">
                        @feedbackText.Length / 2000 characters
                    </small>
                </div>

                @if (!string.IsNullOrWhiteSpace(feedbackError))
                {
                    <div class="alert alert-danger" role="alert">
                        @feedbackError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(feedbackSuccess))
                {
                    <div class="alert alert-success" role="status">
                        @feedbackSuccess
                    </div>
                }

                <button class="btn btn-primary"
                        disabled="@sendingFeedback"
                        @onclick="SubmitFeedbackAsync">
                    @(sendingFeedback ? "Sending..." : "Send Feedback")
                </button>

                <button class="btn btn-outline-secondary ms-2"
                        disabled="@sendingFeedback"
                        @onclick="CancelFeedback">
                    Cancel
                </button>
            </div>
        }

        <div class="activity-card">
            <h2>Recent Submissions</h2>

            @if (!submissions.Any())
            {
                <p>There are no submissions to show yet.</p>
            }
            else
            {
                @foreach (var submission in submissions
                    .Where(s => s.SubmissionId is not null)
                    .OrderByDescending(s => s.SubmittedAt)
                    .Take(5))
                {
                    <div class="activity" @key="submission.SubmissionId">
                        <strong>
                            @submission.StudentName – @submission.ActivityName
                        </strong>
                        <span>
                            @submission.SubmittedAt.ToLocalTime()
                            .ToString("yyyy-MM-dd HH:mm")
                            · @(submission.HasFeedback
                                                            ? "Feedback provided"
                                                            : "Feedback needed")
                        </span>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<TeacherSubmissionDto> submissions = [];
    private TeacherDashboardDto? dashboard;
    private string? dashboardErrorMessage;
    private bool loading = true;
    private string? errorMessage;

    private TeacherSubmissionDto? selectedSubmission;
    private string feedbackText = "";
    private string? feedbackError;
    private string? feedbackSuccess;
    private bool sendingFeedback;

    private string selectedStatus = string.Empty;
    private List<CourseDto> courses = [];
    private int? selectedCourseId;
    private List<ActivityDto> activities = [];
    private int? selectedActivityId;

    // Rows without a SubmissionId represent missing submissions, not pending feedback.
    private int PendingCount =>
        submissions.Count(s => s.SubmissionId is not null && !s.HasFeedback);

    private IEnumerable<TeacherSubmissionDto> PendingSubmissions =>
        submissions
            .Where(s => s.SubmissionId is not null && !s.HasFeedback)
            .OrderBy(s => s.SubmittedAt);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            courses = await Proxy.SendAsync<List<CourseDto>>(
                HttpMethod.Get, "courses") ?? [];

            activities = await Proxy.SendAsync<List<ActivityDto>>(
                HttpMethod.Get, "Activities") ?? [];
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please sign in again.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not load courses and activities. Check that the API is running and try again.";
        }

        await LoadSubmissionsAsync();
        await LoadDashboardAsync();
    }

    private async Task LoadSubmissionsAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var endpoint = "teacher/submissions";
            var queryParameters = new List<string>();

            if (selectedCourseId is int courseId)
                queryParameters.Add("CourseId=" + courseId);

            if (selectedActivityId is int activityId)
                queryParameters.Add("ActivityId=" + activityId);

            if (!string.IsNullOrWhiteSpace(selectedStatus))
                queryParameters.Add("Status=" + Uri.EscapeDataString(selectedStatus));

            if (queryParameters.Count > 0)
                endpoint += "?" + string.Join("&", queryParameters);

            var result = await Proxy.SendAsync<IEnumerable<TeacherSubmissionDto>>(
                HttpMethod.Get, endpoint);

            submissions = result?.ToList() ?? [];
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Your session has expired. Please sign in again.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not load submissions. Check that the API is running and try again.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred while loading submissions.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadDashboardAsync()
    {
        dashboardErrorMessage = null;

        try
        {
            dashboard = await Proxy.SendAsync<TeacherDashboardDto>(
                HttpMethod.Get, "dashboard/teacher");
        }
        catch (UnauthorizedAccessException)
        {
            dashboardErrorMessage = "You are not authorized to load the teacher dashboard. Please sign in again.";
        }
        catch (HttpRequestException)
        {
            dashboardErrorMessage = "Could not load dashboard data from the API.";
        }
        catch (Exception)
        {
            dashboardErrorMessage = "An unexpected error occurred while loading dashboard data.";
        }
    }

    private void SelectSubmission(TeacherSubmissionDto submission)
    {
        if (submission.SubmissionId is null)
            return;

        selectedSubmission = submission;
        feedbackText = "";
        feedbackError = null;
        feedbackSuccess = null;
    }

    private void CancelFeedback()
    {
        selectedSubmission = null;
        feedbackText = "";
        feedbackError = null;
        feedbackSuccess = null;
    }

    private async Task SubmitFeedbackAsync()
    {
        if (selectedSubmission?.SubmissionId is not int submissionId)
        {
            feedbackError = "Select a submitted assignment first.";
            return;
        }

        var text = feedbackText.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            feedbackError = "Enter feedback before sending it.";
            return;
        }

        if (text.Length > 2000)
        {
            feedbackError = "Feedback cannot exceed 2,000 characters.";
            return;
        }

        sendingFeedback = true;
        feedbackError = null;
        feedbackSuccess = null;

        try
        {
            var dto = new FeedbackForCreationDto { Text = text };

            await Proxy.SendAsync<object>(
                HttpMethod.Post,
                "feedback/submission/" + submissionId,
                new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(dto),
                    System.Text.Encoding.UTF8,
                    "application/json"));

            feedbackSuccess = "Feedback has been sent to the student.";
            feedbackText = "";

            await LoadSubmissionsAsync();
            await LoadDashboardAsync();

            selectedSubmission = submissions.FirstOrDefault(
                s => s.SubmissionId == submissionId);
        }
        catch (UnauthorizedAccessException)
        {
            feedbackError = "You are not authorized, or your session has expired. Please sign in again.";
        }
        catch (HttpRequestException)
        {
            feedbackError = "Could not send feedback. Check your connection and try again.";
        }
        catch (Exception)
        {
            feedbackError = "An unexpected error occurred while sending feedback.";
        }
        finally
        {
            sendingFeedback = false;
        }
    }

    private static string GetStatusCssClass(SubmissionStatus status) =>
        status switch
        {
            SubmissionStatus.Submitted => "badge bg-success",
            SubmissionStatus.SubmittedLate => "badge bg-warning text-dark",
            SubmissionStatus.Late => "badge bg-danger",
            SubmissionStatus.NotSubmitted => "badge bg-danger",
            _ => "badge bg-secondary"
        };

    private static string GetStatusText(SubmissionStatus status) =>
        status switch
        {
            SubmissionStatus.Submitted => "Submitted",
            SubmissionStatus.SubmittedLate => "Submitted late",
            SubmissionStatus.Late => "Late",
            SubmissionStatus.NotSubmitted => "Not submitted",
            _ => "Unknown status"
        };

    private Task ApplyFilterAsync() => LoadSubmissionsAsync();

    private async Task ResetFilterAsync()
    {
        selectedStatus = string.Empty;
        selectedCourseId = null;
        selectedActivityId = null;
        await LoadSubmissionsAsync();
    }
}