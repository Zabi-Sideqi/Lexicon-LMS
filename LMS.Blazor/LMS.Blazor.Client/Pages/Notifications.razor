@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@using Domain.Models.Entities
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Student")]
@inject IApiProxyClient Proxy

<PageTitle>Mina notiser</PageTitle>

<h1>Mina notiser</h1>

@if (loading)
{
    <p><em>Hämtar notiser...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}
else if (notifications is null || !notifications.Any())
{
    <div class="alert alert-info">
        Du har inga notiser ännu.
    </div>
}
else
{
    @foreach (var notification in notifications.OrderByDescending(n => n.CreatedAt))
    {
        <div class="card mb-3" @key="notification.Id">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <p class="card-text mb-2">
                        @notification.Message
                    </p>

                    @if (!notification.IsRead)
                    {
                        <span class="badge bg-primary">Ny</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Läst</span>
                    }
                </div>

                <small class="text-muted">
                    @notification.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </small>

                @if (!notification.IsRead)
                {
                    <div class="mt-3">
                        <button class="btn btn-outline-primary btn-sm"
                                disabled="@markingIds.Contains(notification.Id)"
                                @onclick="() => MarkAsReadAsync(notification)">
                            @(markingIds.Contains(notification.Id)
                                ? "Sparar..."
                                : "Markera som läst")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private IEnumerable<Notification>? notifications;
    private readonly HashSet<int> markingIds = [];
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            notifications = await Proxy.SendAsync<IEnumerable<Notification>>(
                HttpMethod.Get,
                "notifications");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Det gick inte att hämta notiser. Försök igen senare.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task MarkAsReadAsync(Notification notification)
    {
        if (notification.IsRead || !markingIds.Add(notification.Id))
        {
            return;
        }

        try
        {
            await Proxy.SendAsync<object>(
                HttpMethod.Patch,
                $"notifications/{notification.Id}/read");

            notification.IsRead = true;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Det gick inte att markera notisen som läst. Försök igen.";
        }
        finally
        {
            markingIds.Remove(notification.Id);
        }
    }
}
