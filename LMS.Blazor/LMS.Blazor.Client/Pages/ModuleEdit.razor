@page "/modules/edit/{id:int}"
@* @page "/modules/edit" *@

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Teacher")]

@* After #36 is merged, uncomment this line (check the DTO namespace): *@
@* @using LMS.Shared.DTOs.ModuleDtos *@
@using System.ComponentModel.DataAnnotations
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Blazor.Client.Services.ApiProxy
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Edit Module</PageTitle>

<h1>Edit Module</h1>

@if (model is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText @bind-Value="model.Name" class="form-control" />
            <ValidationMessage For="() => model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="model.Description" class="form-control" />
            <ValidationMessage For="() => model.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Start Date</label>
            <InputDate @bind-Value="model.StartDate" class="form-control" />
            <ValidationMessage For="() => model.StartDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">End Date</label>
            <InputDate @bind-Value="model.EndDate" class="form-control" />
            <ValidationMessage For="() => model.EndDate" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/modules" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    // ---- Temporary version: local model with fake data, nothing is sent to the API. ----
    // Remove this class, the model, OnInitialized and HandleSubmit when #36 and #38 are done.
    private class TempModuleModel : IValidatableObject
    {
        [Required]
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddDays(14);

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            if (EndDate < StartDate)
                yield return new ValidationResult("End date cannot be before start date.", [nameof(EndDate)]);
        }
    }

    private TempModuleModel? model;

    protected override void OnInitialized()
    {
        model = new TempModuleModel
        {
            Name = $"Module {Id}",
            Description = "Temporary description",
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddDays(14)
        };
    }

    private Task HandleSubmit()
    {
        Navigation.NavigateTo("/modules");
        return Task.CompletedTask;
    }

