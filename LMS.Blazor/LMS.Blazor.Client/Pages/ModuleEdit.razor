@page "/modules/edit/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Shared.DTOs.ModuleDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Edit Module</PageTitle>

<div class="module-edit-page">
    <div class="module-edit-header">
        <div>
            <span class="module-edit-eyebrow">LEXICON LMS</span>
            <h1>Edit Module</h1>
            <p>Update the module details and schedule for your course.</p>
        </div>

        <div class="module-edit-icon" aria-hidden="true">✎</div>
    </div>

    @if (model is null)
    {
        <section class="module-edit-card">
            <div class="module-edit-state">
                <span class="module-edit-spinner" aria-hidden="true"></span>
                <p>Loading module details...</p>
            </div>
        </section>
    }
    else
    {
        <section class="module-edit-card">
            <div class="module-edit-card-heading">
                <h2>Module details</h2>
                <p>Update the information below and save your changes.</p>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (errorMessage is not null)
                {
                    <div class="module-edit-error" role="alert">
                        <span class="module-edit-error-icon"
                              aria-hidden="true">!</span>
                        <div>
                            <strong>Unable to save module</strong>
                            <p>@errorMessage</p>
                        </div>
                    </div>
                }

                <div class="module-edit-field">
                    <label for="module-edit-name">Name</label>
                    <InputText id="module-edit-name"
                               @bind-Value="model.Name"
                               class="module-edit-input"
                               placeholder="Enter module name" />
                    <ValidationMessage For="() => model.Name" />
                </div>

                <div class="module-edit-field">
                    <label for="module-edit-description">Description</label>
                    <InputTextArea id="module-edit-description"
                                   @bind-Value="model.Description"
                                   class="module-edit-input module-edit-textarea"
                                   placeholder="Describe what this module covers" />
                    <ValidationMessage For="() => model.Description" />
                </div>

                <div class="module-edit-date-grid">
                    <div class="module-edit-field">
                        <label for="module-edit-start-date">Start date</label>
                        <InputDate id="module-edit-start-date"
                                   @bind-Value="model.StartDate"
                                   class="module-edit-input" />
                        <ValidationMessage For="() => model.StartDate" />
                    </div>

                    <div class="module-edit-field">
                        <label for="module-edit-end-date">End date</label>
                        <InputDate id="module-edit-end-date"
                                   @bind-Value="model.EndDate"
                                   class="module-edit-input" />
                        <ValidationMessage For="() => model.EndDate" />
                    </div>
                </div>

                <div class="module-edit-actions">
                    <a href="/courses/@model.CourseId/modules"
                       class="module-edit-cancel">
                        Cancel
                    </a>

                    <button type="submit" class="module-edit-submit">
                        <span aria-hidden="true">✓</span>
                        Save changes
                    </button>
                </div>
            </EditForm>
        </section>

        <p class="module-edit-footer">
            Make sure the module dates are within the course schedule.
        </p>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ModuleForUpdateDto? model;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var module = await Proxy.GetAsync<ModuleDto>($"modules/{Id}");

        if (module is null)
        {
            Navigation.NavigateTo("/courses");
            return;
        }

        model = new ModuleForUpdateDto
        {
            CourseId = module.CourseId,
            Name = module.Name,
            Description = module.Description,
            StartDate = module.StartDate,
            EndDate = module.EndDate
        };
    }

    private async Task HandleSubmit()
    {
        if (model is null) return;

        errorMessage = null;

        if (model.EndDate < model.StartDate)
        {
            errorMessage = "End date cannot be before start date.";
            return;
        }

        try
        {
            await Proxy.SendAsync<ModuleDto>(
                HttpMethod.Put,
                $"modules/{Id}",
                JsonContent.Create(model));

            Navigation.NavigateTo($"/courses/{model.CourseId}/modules");
        }
        catch (Exception)
        {
            errorMessage = "The module could not be saved. The server rejected it, for example because the dates overlap another module or fall outside the course dates.";
        }
    }
}
