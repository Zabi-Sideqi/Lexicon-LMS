@page "/modules/edit/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Shared.DTOs.ModuleDtos
@using LMS.Blazor.Client.Services.ApiProxy
@attribute [Authorize(Roles = "Teacher")]
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Redigera modul</PageTitle>

<div class="module-edit-page">
    <div class="module-edit-header">
        <div>
            <span class="module-edit-eyebrow">LEXICON LMS</span>
            <h1>Redigera modul</h1>
            <p>Uppdatera modulens information och datum.</p>
        </div>

        <div class="module-edit-icon" aria-hidden="true">✎</div>
    </div>

    @if (model is null)
    {
        <section class="module-edit-card">
            <div class="module-edit-state">
                <span class="module-edit-spinner" aria-hidden="true"></span>
                <p>Laddar modulens uppgifter...</p>
            </div>
        </section>
    }
    else
    {
        <section class="module-edit-card">
            <div class="module-edit-card-heading">
                <h2>Moduluppgifter</h2>
                <p>Ändra informationen nedan och spara.</p>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (errorMessage is not null)
                {
                    <div class="module-edit-error" role="alert">
                        <span class="module-edit-error-icon"
                              aria-hidden="true">!</span>
                        <div>
                            <strong>Modulen kunde inte sparas</strong>
                            <p>@errorMessage</p>
                        </div>
                    </div>
                }

                <div class="module-edit-field">
                    <label for="module-edit-name">Namn</label>
                    <InputText id="module-edit-name"
                               @bind-Value="model.Name"
                               class="module-edit-input"
                               placeholder="Ange modulens namn" />
                    <ValidationMessage For="() => model.Name" />
                </div>

                <div class="module-edit-field">
                    <label for="module-edit-description">Beskrivning</label>
                    <InputTextArea id="module-edit-description"
                                   @bind-Value="model.Description"
                                   class="module-edit-input module-edit-textarea"
                                   placeholder="Beskriv modulens innehåll" />
                    <ValidationMessage For="() => model.Description" />
                </div>

                <div class="module-edit-date-grid">
                    <div class="module-edit-field">
                        <label for="module-edit-start-date">Startdatum</label>
                        <InputDate id="module-edit-start-date"
                                   @bind-Value="model.StartDate"
                                   class="module-edit-input" />
                        <ValidationMessage For="() => model.StartDate" />
                    </div>

                    <div class="module-edit-field">
                        <label for="module-edit-end-date">Slutdatum</label>
                        <InputDate id="module-edit-end-date"
                                   @bind-Value="model.EndDate"
                                   class="module-edit-input" />
                        <ValidationMessage For="() => model.EndDate" />
                    </div>
                </div>

                <div class="module-edit-actions">
                    <a href="/courses/@model.CourseId/modules"
                       class="module-edit-cancel">
                        Avbryt
                    </a>

                    <button type="submit" class="module-edit-submit">
                        <span aria-hidden="true">✓</span>
                        Spara ändringar
                    </button>
                </div>
            </EditForm>
        </section>

        <p class="module-edit-footer">
            Kontrollera att modulens datum ligger inom kursens period.
        </p>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ModuleForUpdateDto? model;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var module = await Proxy.GetAsync<ModuleDto>($"modules/{Id}");

        if (module is null)
        {
            Navigation.NavigateTo("/courses");
            return;
        }

        model = new ModuleForUpdateDto
        {
            CourseId = module.CourseId,
            Name = module.Name,
            Description = module.Description,
            StartDate = module.StartDate,
            EndDate = module.EndDate
        };
    }

    private async Task HandleSubmit()
    {
        if (model is null) return;

        errorMessage = null;

        if (model.EndDate < model.StartDate)
        {
            errorMessage = "Slutdatumet kan inte vara före startdatumet.";
            return;
        }

        try
        {
            await Proxy.SendAsync<ModuleDto>(
                HttpMethod.Put,
                $"modules/{Id}",
                JsonContent.Create(model));

            Navigation.NavigateTo($"/courses/{model.CourseId}/modules");
        }
        catch (Exception)
        {
            errorMessage = "Modulen kunde inte sparas. Kontrollera att datumen ligger inom kursens period och inte överlappar en annan modul.";
        }
    }
}
