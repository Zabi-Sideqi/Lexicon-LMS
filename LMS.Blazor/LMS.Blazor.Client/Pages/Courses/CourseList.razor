@page "/courses"
@attribute [Authorize(Roles = "Teacher")]
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@inject IApiProxyClient Proxy

<PageTitle>Courses</PageTitle>

<div class="course-page">
    <div class="course-page-header">
        <div>
            <span class="course-eyebrow">LEXICON LMS</span>
            <h1>Courses</h1>
            <p>Manage your courses and learning modules.</p>
        </div>

        <a href="/courses/create" class="btn btn-primary course-create-button">
            <span aria-hidden="true">+</span>
            Create Course
        </a>
    </div>

    @if (courses is null)
    {
        <div class="course-state">
            <span class="course-loading-indicator"></span>
            <p>Loading courses...</p>
        </div>
    }
    else if (!courses.Any())
    {
        <div class="course-state">
            <div class="course-empty-icon" aria-hidden="true">▤</div>
            <h2>No courses found</h2>
            <p>Create a course to get started.</p>
            <a href="/courses/create" class="btn btn-primary">Create Course</a>
        </div>
    }
    else
    {
        <div class="course-summary">
            <div>
                <span class="course-summary-label">Total courses</span>
                <strong>@courses.Count()</strong>
            </div>
            <span class="course-summary-icon" aria-hidden="true">▤</span>
        </div>

        <section class="course-table-card">
            <div class="course-table-heading">
                <div>
                    <h2>Your courses</h2>
                    <p>View course details and manage modules.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table course-table">
                    <thead>
                        <tr>
                            <th scope="col">Course name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Start date</th>
                            <th scope="col">End date</th>
                            <th scope="col" class="course-actions-heading">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in courses)
                        {
                            <tr @key="course.Id">
                                <td>
                                    <div class="course-name-cell">
                                        <span class="course-name-icon" aria-hidden="true">▤</span>
                                        <strong>@course.Name</strong>
                                    </div>
                                </td>
                                <td class="course-description">
                                    @course.Description
                                </td>
                                <td>@course.StartDate.ToShortDateString()</td>
                                <td>@course.EndDate.ToShortDateString()</td>
                                <td>
                                    <div class="course-row-actions">
                                        <a href="/courses/edit/@course.Id"
                                           class="btn btn-sm btn-secondary">
                                            Edit
                                        </a>
                                        <a href="/courses/@course.Id/modules"
                                           class="btn btn-sm btn-outline-primary">
                                            Modules
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private IEnumerable<CourseDto>? courses;

    protected override async Task OnInitializedAsync()
    {
        courses = await Proxy.GetAsync<IEnumerable<CourseDto>>("courses");
    }
}
