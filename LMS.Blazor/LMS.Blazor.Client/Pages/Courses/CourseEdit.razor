@page "/courses/edit/{id:int}"
@attribute [Authorize(Roles = "Teacher")]
@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@inject IApiProxyClient Proxy
@inject NavigationManager Navigation

<PageTitle>Edit Course</PageTitle>

<div class="course-form-page">
    <div class="course-form-header">
        <div>
            <span class="course-form-eyebrow">LEXICON LMS</span>
            <h1>Edit Course</h1>
            <p>Update the course details and schedule.</p>
        </div>

        <a href="/courses" class="btn btn-outline-primary">
            &larr; Back to courses
        </a>
    </div>

    @if (model is null)
    {
        <div class="course-edit-loading">
            <span class="course-edit-spinner"></span>
            <p>Loading course details...</p>
        </div>
    }
    else
    {
        <div class="course-form-card">
            <div class="course-form-card-header">
                <div class="course-form-icon" aria-hidden="true">✎</div>
                <div>
                    <h2>Course details</h2>
                    <p>Update the information for this course.</p>
                </div>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="course-form-body">
                    <div class="mb-4">
                        <label for="course-name" class="form-label">Name</label>
                        <InputText id="course-name"
                                   @bind-Value="model.Name"
                                   class="form-control"
                                   placeholder="Enter course name" />
                        <ValidationMessage For="() => model.Name" />
                    </div>

                    <div class="mb-4">
                        <label for="course-description" class="form-label">Description</label>
                        <InputTextArea id="course-description"
                                       @bind-Value="model.Description"
                                       class="form-control course-description-input"
                                       placeholder="Describe the course" />
                        <ValidationMessage For="() => model.Description" />
                    </div>

                    <div class="course-date-grid">
                        <div class="mb-4">
                            <label for="course-start-date" class="form-label">Start Date</label>
                            <InputDate id="course-start-date"
                                       @bind-Value="model.StartDate"
                                       class="form-control" />
                            <ValidationMessage For="() => model.StartDate" />
                        </div>

                        <div class="mb-4">
                            <label for="course-end-date" class="form-label">End Date</label>
                            <InputDate id="course-end-date"
                                       @bind-Value="model.EndDate"
                                       class="form-control" />
                            <ValidationMessage For="() => model.EndDate" />
                        </div>
                    </div>
                </div>

                <div class="course-form-footer">
                    <a href="/courses" class="btn btn-light course-cancel-button">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary course-submit-button">
                        Save Changes
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private CourseForUpdateDto? model;

    protected override async Task OnInitializedAsync()
    {
        var course = await Proxy.GetAsync<CourseDto>($"courses/{Id}");

        if (course is null)
        {
            Navigation.NavigateTo("/courses");
            return;
        }

        model = new CourseForUpdateDto
        {
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };
    }

    private async Task HandleSubmit()
    {
        if (model is null) return;

        await Proxy.SendAsync<CourseDto>(
            HttpMethod.Put,
            $"courses/{Id}",
            JsonContent.Create(model));

        Navigation.NavigateTo("/courses");
    }
}
