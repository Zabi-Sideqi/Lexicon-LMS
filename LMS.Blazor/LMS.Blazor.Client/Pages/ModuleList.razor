            new(2, "Modul 2: Backend-utveckling med ASP.NET Core Web API", "Hur man bygger moderna, säkra och skalbara API:er (rest-tjänster).", new DateTime(2026, 10, 1), new DateTime(2026, 10, 31))
        ];
    }

