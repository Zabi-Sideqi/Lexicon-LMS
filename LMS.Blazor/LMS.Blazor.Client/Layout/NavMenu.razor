@implements IDisposable
@inject NavigationManager NavigationManager

<div class="nav-item px-3">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <span class="nav-icon">⌂</span>
        Översikt
    </NavLink>
</div>

<AuthorizeView Roles="Teacher">
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="courses">
                <span class="nav-icon">▣</span>
                Alla kurser
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="nav-icon">♙</span>
                Användare
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Student">
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="my-course">
                <span class="nav-icon">▣</span>
                Min kurs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="assignments">
                <span class="nav-icon">▤</span>
                Mina uppgifter
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents">
                <span class="nav-icon">▧</span>
                Dokument
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calendar">
                <span class="nav-icon">□</span>
                Schema
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="nav-icon">◉</span>
                Notiser
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <span class="nav-link" aria-current="page">
                @context.User.Identity?.Name
            </span>
        </div>
        <div class="nav-item px-3">
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="nav-link">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                    Logga ut
                </button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Account/Login">
                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                Logga in
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}