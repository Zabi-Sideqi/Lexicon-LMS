@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<header class="topbar">
    <div class="top-left">

        <button class="icon-btn hamburger-btn"
                type="button"
                aria-label="Öppna meny"
                @onclick="ToggleSidebar">
            ☰
        </button>

        <span class="hide-mobile">Lexicon LMS</span>
    </div>

    <div class="top-right">

        <button class="icon-btn" type="button">
            🔔
        </button>

        <div class="user-chip">
            ♙

            <AuthorizeView Roles="Teacher">
                <Authorized>
                    <span>Lärare</span>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Student">
                <Authorized>
                    <span>Elev</span>
                </Authorized>
            </AuthorizeView>
        </div>

        <form action="Account/Logout" method="post" class="topbar-logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="Account/Login" />

            <button class="icon-btn" type="submit" aria-label="Logga ut" title="Logga ut">
                ↪
            </button>
        </form>

        <button class="icon-btn" type="button">
            ☾
        </button>

    </div>
</header>

<aside class="sidebar @(isSidebarOpen ? "sidebar-open" : "")">
    <NavMenu />
</aside>

<main class="main">
    @Body
</main>

@code {
    private bool isSidebarOpen;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}