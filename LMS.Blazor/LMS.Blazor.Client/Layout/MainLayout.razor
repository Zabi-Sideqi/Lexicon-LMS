@using Microsoft.AspNetCore.Components.Authorization
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.NotificationDtos
@using System.Threading
@inject IApiProxyClient ApiProxyClient
@inherits LayoutComponentBase
@implements IDisposable

<div class="app-shell @(isDarkMode ? "dark-mode" : "")">

    <header class="topbar">
        <div class="top-left">

            <button class="icon-btn hamburger-btn"
                    type="button"
                    aria-label="Toggle navigation menu"
                    aria-controls="main-sidebar"
                    aria-expanded="@isSidebarOpen"
                    @onclick="ToggleSidebar">
                ☰
            </button>

            <span class="hide-mobile">Lexicon LMS</span>
        </div>

        <div class="top-right">

            <button class="icon-btn notification-btn"
                    type="button"
                    aria-label="@($"Notifications, {UnreadNotificationCount} unread")"
                    aria-expanded="@showNotifications"
                    title="Notifications"
                    @onclick="ToggleNotifications">
                🔔
                @if (UnreadNotificationCount > 0)
                {
                    <span class="notification-badge">
                        @(UnreadNotificationCount > 99 ? "99+" : UnreadNotificationCount)
                    </span>
                }
            </button>

            @if (showNotifications)
            {
                <div class="notification-panel"
                     role="region"
                     aria-label="Notifications">
                    <h3>Notifications</h3>

                    @if (!string.IsNullOrWhiteSpace(notificationMessage))
                    {
                        <div class="alert @(notificationError ? "alert-danger" : "alert-success") m-2" role="@(notificationError ? "alert" : "status")">
                            @notificationMessage
                        </div>
                    }

                    @if (notifications.Count == 0)
                    {
                        <p>You have no notifications.</p>
                    }
                    else
                    {
                        @foreach (var notification in notifications)
                        {
                            <div class="notification-item">
                                <p>@notification.Message</p>
                                <small>@notification.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>

                                @if (!notification.IsRead)
                                {
                                    <button type="button"
                                            class="mark-as-read-btn"
                                            @onclick="() => MarkAsReadAsync(notification.Id)">
                                        Mark as read
                                    </button>
                                }
                                else
                                {
                                    <span class="read-status">Read</span>
                                }
                            </div>
                        }
                    }
                </div>
            }

            <div class="user-chip">
                ♙

                <AuthorizeView Roles="Teacher">
                    <Authorized>
                        <span>Teacher</span>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Student">
                    <Authorized>
                        <span>Student</span>
                    </Authorized>
                </AuthorizeView>
            </div>

            <form action="Account/Logout" method="post" class="topbar-logout-form">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="Account/Login" />

                <button class="icon-btn"
                        type="submit"
                        aria-label="Log out"
                        title="Log out">
                    ↪
                </button>
            </form>

            <button class="icon-btn"
                    type="button"
                    aria-label="Toggle dark mode"
                    aria-pressed="@isDarkMode"
                    title="Toggle dark mode"
                    @onclick="ToggleDarkMode">
                @(isDarkMode ? "☀" : "☾")
            </button>

        </div>
    </header>

    <aside id="main-sidebar"
           class="sidebar @(isSidebarOpen ? "sidebar-open" : "")">
        <NavMenu OnNavigate="CloseSidebar" />
    </aside>

    @if (isSidebarOpen)
    {
        <button class="sidebar-backdrop"
                type="button"
                aria-label="Close navigation menu"
                @onclick="CloseSidebar">
        </button>
    }

    <main class="main">
        @Body
    </main>

</div>

@code {
    private bool isSidebarOpen;
    private bool isDarkMode;
    private List<NotificationDto> notifications = [];

    private int UnreadNotificationCount =>
        notifications.Count(notification => !notification.IsRead);

    private bool notificationsLoaded;
    private PeriodicTimer? notificationTimer;
    private CancellationTokenSource? notificationCts;
    private bool showNotifications;
    private string? notificationMessage;
    private bool notificationError;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
    }

    private void ToggleNotifications()
    {
        showNotifications = !showNotifications;
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            var result = await ApiProxyClient.GetAsync<List<NotificationDto>>(
                "notifications");

            notifications = result ?? [];
            notificationMessage = null;
            notificationError = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (UnauthorizedAccessException)
        {
            notificationMessage = "Your session has expired. Please log in again.";
            notificationError = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException)
        {
            notificationMessage = "Notifications could not be loaded. Please try again.";
            notificationError = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || notificationsLoaded)
            return;

        notificationsLoaded = true;

        await LoadNotificationsAsync();

        notificationCts = new CancellationTokenSource();
        notificationTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = PollNotificationsAsync(notificationCts.Token);
    }

    private async Task MarkAsReadAsync(int notificationId)
    {
        try
        {
            await ApiProxyClient.PatchAsync<object>(
                $"notifications/{notificationId}/read");

            var notification = notifications
                .FirstOrDefault(n => n.Id == notificationId);

            if (notification is not null)
            {
                var index = notifications.IndexOf(notification);
                notifications[index] = notification with { IsRead = true };
                notificationMessage = "Notification marked as read.";
                notificationError = false;

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (UnauthorizedAccessException)
        {
            notificationMessage = "Your session has expired. Please log in again.";
            notificationError = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException)
        {
            notificationMessage = "The notification could not be marked as read. Please try again.";
            notificationError = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollNotificationsAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (notificationTimer is not null &&
                   await notificationTimer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadNotificationsAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Polling stopped when the component was disposed.
        }
    }

    public void Dispose()
    {
        notificationCts?.Cancel();
        notificationTimer?.Dispose();
        notificationCts?.Dispose();
    }
}
